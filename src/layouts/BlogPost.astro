---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { basePath as base, topicHref } from '../utils/content';

type ArticleLink = { title: string; id: string };
type Heading = { depth: number; slug: string; text: string };
type Props = CollectionEntry<'blog'>['data'] & {
	metaText?: string;
	headings?: Heading[];
	readingMinutes?: number;
	previous?: ArticleLink;
	next?: ArticleLink;
	related?: ArticleLink[];
};

const {
	title, description, pubDate, updatedDate, heroImage, category, tags = [],
	metaText, headings = [], readingMinutes, previous, next, related = [],
} = Astro.props;
const contents = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const articleURL = (id: string) => `${base}blog/${id}/`;
const topicURL = topicHref(category ?? '随笔');
const pad = (value: number) => String(value).padStart(2, '0');
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			article={{ publishedTime: pubDate, modifiedTime: updatedDate, section: category, tags }}
		/>
	</head>
	<body>
		<progress class="reading-progress" data-reading-progress max="100" value="0" aria-label="文章阅读进度"></progress>
		<Header />
		<main class="reading-page" id="main-content">
			<article aria-labelledby="article-title">

				<!-- Article head: a full-width masthead on a hairline, with the
				     metadata set in the left column so the title can run wide. -->
				<header class="article-header">
					<a class="back-link" href={`${base}blog/`}><span aria-hidden="true">←</span> 全部文章</a>
					<div class="grid article-head-grid">
						<div class="article-head-main">
							<div class="article-kicker">
								<a href={topicURL}>{category ?? '随笔'}</a>
								<span aria-hidden="true">/</span>
								<span>FIELD NOTES</span>
							</div>
							<h1 id="article-title">{title}</h1>
							<p class="article-description">{description}</p>
						</div>
						<dl class="article-facts">
							<div>
								<dt>发布</dt>
								<dd>{metaText ?? <FormattedDate date={pubDate} />}</dd>
							</div>
							{readingMinutes && (
								<div>
									<dt>阅读</dt>
									<dd>约 {readingMinutes} 分钟</dd>
								</div>
							)}
							{updatedDate && (
								<div>
									<dt>更新</dt>
									<dd><FormattedDate date={updatedDate} /></dd>
								</div>
							)}
							<div>
								<dt>分类</dt>
								<dd><a href={topicURL}>{category ?? '随笔'}</a></dd>
							</div>
						</dl>
					</div>
				</header>

				{contents.length > 0 && (
					<details class="mobile-contents">
						<summary>文章目录 <span>{contents.length} 个小节</span></summary>
						<nav aria-label="文章目录">
							<ol class="contents-list">
								{contents.map((heading, i) => (
									<li class:list={{ 'sub-heading': heading.depth === 3 }}>
										<a href={`#${heading.slug}`} data-heading-link={heading.slug}>
											{heading.depth === 2 && <span class="toc-index" aria-hidden="true">{pad(contents.filter((h, j) => h.depth === 2 && j <= i).length)}</span>}
											<span class="toc-text">{heading.text}</span>
										</a>
									</li>
								))}
							</ol>
						</nav>
					</details>
				)}

				<div class="reading-grid">
					<div class="article-column">
						<div class="article-prose" data-article-body><slot /></div>
						<footer class="article-footer">
							<p class="eyebrow label-plain">文章主题</p>
							<div class="article-topics">
								<a href={topicURL}>{category ?? '随笔'} <span aria-hidden="true">↗</span></a>
								{tags.map((tag) => <a href={`${base}blog/?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}
							</div>
							<a class="back-top" href="#article-title">回到文章开头 <span aria-hidden="true">↑</span></a>
						</footer>
					</div>

					{contents.length > 0 && (
						<aside class="desktop-contents">
							<nav class="contents-sticky" aria-label="文章目录">
								<p class="eyebrow label-plain">目录 / ON THIS PAGE</p>
								<ol class="contents-list">
									{contents.map((heading, i) => (
										<li class:list={{ 'sub-heading': heading.depth === 3 }}>
											<a href={`#${heading.slug}`} data-heading-link={heading.slug}>
												{heading.depth === 2 && <span class="toc-index" aria-hidden="true">{pad(contents.filter((h, j) => h.depth === 2 && j <= i).length)}</span>}
												<span class="toc-text">{heading.text}</span>
											</a>
										</li>
									))}
								</ol>
							</nav>
						</aside>
					)}
				</div>

				{(previous || next) && (
					<nav class="article-neighbors" aria-label="相邻文章">
						{previous ? (
							<a href={articleURL(previous.id)} rel="prev">
								<span class="neighbor-label">← 上一篇</span>
								<strong>{previous.title}</strong>
							</a>
						) : <div />}
						{next ? (
							<a href={articleURL(next.id)} rel="next">
								<span class="neighbor-label">下一篇 →</span>
								<strong>{next.title}</strong>
							</a>
						) : <div />}
					</nav>
				)}
			</article>

			{related.length > 0 && (
				<section class="related-writing" aria-labelledby="related-title">
					<div class="section-heading">
						<div>
							<p class="eyebrow">继续阅读</p>
							<h2 id="related-title">沿着这个话题</h2>
						</div>
						<a class="text-link" href={topicURL}>全部 {category} <span aria-hidden="true">→</span></a>
					</div>
					<ol class="related-list">
						{related.map((item, index) => (
							<li>
								<span class="related-index">{pad(index + 1)}</span>
								<a href={articleURL(item.id)}>{item.title} <span aria-hidden="true">↗</span></a>
							</li>
						))}
					</ol>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>

<script>
	const article = document.querySelector<HTMLElement>('[data-article-body]');
	const progress = document.querySelector<HTMLProgressElement>('[data-reading-progress]');
	const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-heading-link]')];
	const headings = article ? [...article.querySelectorAll<HTMLElement>('h2[id], h3[id]')] : [];
	const header = document.querySelector<HTMLElement>('.site-header');
	let scheduled = false;
	let activeSlug = '';

	function updateReadingState() {
		scheduled = false;
		if (!article || !progress) return;
		const headerHeight = header?.getBoundingClientRect().height ?? 68;
		const offset = headerHeight + 32;
		document.documentElement.style.setProperty('--reading-offset', `${offset}px`);
		const bounds = article.getBoundingClientRect();
		const traveled = window.innerHeight - bounds.top;
		const distance = bounds.height + window.innerHeight - offset;
		progress.value = Math.max(0, Math.min(100, traveled / distance * 100));
		let current = '';
		for (const heading of headings) {
			if (heading.getBoundingClientRect().top > offset + 24) break;
			current = heading.id;
		}
		if (current === activeSlug) return;
		activeSlug = current;
		for (const link of links) {
			if (link.dataset.headingLink === current) link.setAttribute('aria-current', 'location');
			else link.removeAttribute('aria-current');
		}
	}

	function scheduleUpdate() {
		if (scheduled) return;
		scheduled = true;
		requestAnimationFrame(updateReadingState);
	}

	window.addEventListener('scroll', scheduleUpdate, { passive: true });
	window.addEventListener('resize', scheduleUpdate, { passive: true });
	window.addEventListener('load', scheduleUpdate, { once: true });
	if (article) new ResizeObserver(scheduleUpdate).observe(article);
	updateReadingState();
</script>

<style>
	:global(html:has(.reading-page)) {
		scroll-padding-top: 0;
	}

	.reading-progress {
		position: fixed;
		inset: 0 0 auto;
		z-index: 40;
		width: 100%;
		height: 3px;
		border: 0;
		appearance: none;
		color: var(--accent);
		background: transparent;
	}
	.reading-progress::-webkit-progress-bar {
		background: transparent;
	}
	.reading-progress::-webkit-progress-value {
		background: var(--accent);
	}
	.reading-progress::-moz-progress-bar {
		background: var(--accent);
	}

	.reading-page {
		width: min(1180px, 100%);
		margin-inline: auto;
		padding-inline: var(--page-pad);
	}

	/* --- Article head ----------------------------------------------------- */

	.article-header {
		padding-bottom: var(--space-l);
		border-bottom: 1px solid var(--line-ink);
	}
	.back-link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2xs);
		min-height: 44px;
		margin-bottom: var(--space-m);
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: var(--step--2);
		letter-spacing: 0.06em;
		text-decoration: none;
	}
	.back-link:hover {
		color: var(--accent-text);
	}
	.article-head-main {
		grid-column: 1 / span 8;
	}
	.article-kicker {
		display: flex;
		align-items: center;
		gap: var(--space-2xs);
		margin-bottom: var(--space-s);
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: var(--step--2);
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.article-kicker a {
		display: inline-block;
		margin-block: -6px;
		padding-block: 6px;
		color: var(--accent-text);
		text-decoration: none;
	}
	.article-kicker a:hover {
		text-decoration: underline;
	}
	.article-header h1 {
		margin: 0 0 var(--space-s);
		font-family: var(--font-display);
		font-size: var(--step-4);
		font-weight: 400;
		line-height: 1.28;
		letter-spacing: -0.032em;
		scroll-margin-top: var(--reading-offset, 100px);
	}
	.article-description {
		max-width: 46rem;
		margin: 0;
		color: var(--muted);
		font-size: var(--step-1);
		line-height: 1.72;
	}

	/* Facts settle into a right column, reading as a spec block. */
	.article-facts {
		grid-column: 10 / -1;
		align-self: end;
		margin: 0;
		border-top: 1px solid var(--line-ink);
	}
	.article-facts > div {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-2xs);
		padding-block: var(--space-3xs);
		border-bottom: 1px solid var(--line);
	}
	.article-facts dt {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: var(--step--2);
		letter-spacing: 0.08em;
	}
	.article-facts dd {
		margin: 0;
		font-size: var(--step--2);
		text-align: right;
	}
	.article-facts dd a {
		display: inline-block;
		margin-block: -4px;
		padding-block: 4px;
	}

	/* --- Reading grid ----------------------------------------------------- */

	.reading-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 190px);
		gap: clamp(2rem, 5vw, 4.5rem);
		padding-top: var(--space-xl);
	}
	.article-column {
		min-width: 0;
	}
	.article-prose {
		max-width: var(--measure);
		font-size: var(--step-0);
		line-height: 1.9;
		overflow-wrap: anywhere;
	}
	.article-prose :global(h1),
	.article-prose :global(h2),
	.article-prose :global(h3),
	.article-prose :global(h4) {
		scroll-margin-top: var(--reading-offset, 100px);
		overflow-wrap: anywhere;
	}
	.article-prose :global(h2) {
		margin: var(--space-2xl) 0 var(--space-s);
		padding-top: var(--space-s);
		border-top: 1px solid var(--line);
		font-family: var(--font-display);
		font-size: var(--step-2);
		font-weight: 400;
		letter-spacing: -0.02em;
		line-height: 1.4;
	}
	.article-prose :global(h2:first-child) {
		margin-top: 0;
		padding-top: 0;
		border-top: 0;
	}
	.article-prose :global(h3) {
		margin: var(--space-xl) 0 var(--space-xs);
		font-size: var(--step-1);
		letter-spacing: -0.01em;
	}
	.article-prose :global(h4) {
		margin: var(--space-l) 0 var(--space-2xs);
		font-size: var(--step-0);
		font-weight: 700;
	}
	.article-prose :global(p) {
		margin: 0 0 var(--space-m);
	}
	.article-prose :global(ul),
	.article-prose :global(ol) {
		margin: var(--space-s) 0 var(--space-m);
		padding-left: 1.4rem;
	}
	.article-prose :global(li) {
		margin: 0.4rem 0;
	}
	.article-prose :global(li > ul),
	.article-prose :global(li > ol) {
		margin-block: var(--space-2xs);
	}
	.article-prose :global(li::marker) {
		color: var(--muted);
	}
	.article-prose :global(a) {
		text-decoration-thickness: 1px;
	}
	.article-prose :global(img) {
		display: block;
		max-width: 100%;
		height: auto;
		margin: var(--space-l) auto;
		border: 1px solid var(--line);
	}
	.article-prose :global(figure) {
		max-width: 100%;
		margin: var(--space-l) 0;
	}
	.article-prose :global(figcaption) {
		margin-top: var(--space-2xs);
		color: var(--muted);
		font-size: var(--step--2);
		text-align: center;
	}
	.article-prose :global(pre) {
		max-width: 100%;
		min-width: 0;
		margin: var(--space-m) 0;
		padding: var(--space-m);
		font-size: 0.83rem;
		line-height: 1.72;
		overflow-wrap: normal;
	}
	.article-prose :global(pre code) {
		white-space: pre;
	}
	.article-prose :global(:not(pre) > code) {
		font-size: 0.86em;
	}
	.article-prose :global(blockquote) {
		margin: var(--space-l) 0;
		padding: var(--space-2xs) 0 var(--space-2xs) var(--space-m);
		border-left: 2px solid var(--accent);
		color: var(--ink-2);
	}
	.article-prose :global(blockquote > :last-child) {
		margin-bottom: 0;
	}
	.article-prose :global(table) {
		display: block;
		max-width: 100%;
		margin: var(--space-l) 0;
		overflow-x: auto;
		border-collapse: collapse;
		font-size: var(--step--1);
		line-height: 1.65;
	}
	.article-prose :global(th),
	.article-prose :global(td) {
		min-width: 100px;
		padding: 0.7rem 0.9rem;
		border: 1px solid var(--line);
		text-align: left;
	}
	.article-prose :global(th) {
		color: var(--ink);
		background: var(--surface-sunk);
		font-family: var(--font-mono);
		font-size: var(--step--2);
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.article-prose :global(hr) {
		margin: var(--space-xl) 0;
	}
	.article-prose :global(video),
	.article-prose :global(iframe),
	.article-prose :global(svg) {
		max-width: 100%;
	}

	/* --- Contents rail ---------------------------------------------------- */

	.contents-sticky {
		position: sticky;
		top: var(--reading-offset, 100px);
		max-height: calc(100dvh - var(--reading-offset, 100px) - 24px);
		overflow-y: auto;
		padding-right: var(--space-2xs);
	}
	.contents-sticky .eyebrow {
		padding-bottom: var(--space-2xs);
		border-bottom: 1px solid var(--line-ink);
	}
	.contents-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.contents-list li {
		margin: 0;
	}
	.contents-list a {
		display: grid;
		grid-template-columns: 1.6rem minmax(0, 1fr);
		align-items: baseline;
		gap: var(--space-3xs);
		padding: var(--space-2xs) 0;
		border-bottom: 1px solid var(--line);
		color: var(--muted);
		font-size: var(--step--2);
		line-height: 1.55;
		text-decoration: none;
		overflow-wrap: anywhere;
		transition: color var(--motion-fast), padding-left var(--motion-base);
	}
	.toc-index {
		color: var(--muted);
		font-family: var(--font-mono);
		font-variant-numeric: tabular-nums;
	}
	/* The active section takes the accent bar and shifts right — the same
	   gesture as the navigation and the category filter. */
	.contents-list a[aria-current] {
		padding-left: var(--space-2xs);
		color: var(--accent-text);
		box-shadow: inset 2px 0 0 var(--accent);
	}
	.contents-list a[aria-current] .toc-index {
		color: var(--accent-text);
	}
	.contents-list a:hover {
		color: var(--ink);
	}
	/* Sub-headings drop the index column and indent instead. */
	.contents-list .sub-heading a {
		grid-template-columns: minmax(0, 1fr);
		padding-left: 1.6rem;
		font-size: var(--step--2);
	}
	.contents-list .sub-heading a[aria-current] {
		padding-left: calc(1.6rem + var(--space-2xs));
	}

	.mobile-contents {
		display: none;
	}

	/* --- Article footer --------------------------------------------------- */

	.article-footer {
		max-width: var(--measure);
		margin-top: var(--space-xl);
		padding-top: var(--space-m);
		border-top: 1px solid var(--line-ink);
	}
	.article-topics {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3xs);
	}
	.article-topics > a {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3xs);
		min-height: 40px;
		padding: 0.25rem 0.65rem;
		border: 1px solid var(--line);
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: var(--step--2);
		text-decoration: none;
		transition: color var(--motion-fast), border-color var(--motion-fast);
	}
	.article-topics > a:hover {
		color: var(--accent-text);
		border-color: var(--accent);
	}
	.back-top {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2xs);
		min-height: 44px;
		margin-top: var(--space-xs);
		color: var(--muted);
		font-size: var(--step--2);
		text-decoration: none;
	}
	.back-top:hover {
		color: var(--accent-text);
	}

	/* --- Neighbors -------------------------------------------------------- */

	.article-neighbors {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-l);
		margin-top: var(--space-2xl);
		border-top: 1px solid var(--line-ink);
	}
	.article-neighbors a {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
		padding-block: var(--space-m);
		color: var(--ink);
		text-decoration: none;
	}
	.neighbor-label {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: var(--step--2);
	}
	.article-neighbors strong {
		max-width: 26rem;
		font-size: var(--step-0);
		font-weight: 400;
		line-height: 1.6;
		transition: color var(--motion-fast);
	}
	.article-neighbors a:hover strong {
		color: var(--accent-text);
	}

	/* --- Related ---------------------------------------------------------- */

	.related-writing {
		margin-top: var(--space-2xl);
	}
	.related-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.related-list li {
		display: grid;
		grid-template-columns: 3rem minmax(0, 1fr);
		align-items: baseline;
		gap: var(--space-s);
		border-bottom: 1px solid var(--line);
	}
	.related-index {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: var(--step--2);
		font-variant-numeric: tabular-nums;
	}
	.related-list a {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-s);
		padding-block: var(--space-s);
		color: var(--ink);
		font-size: var(--step-0);
		text-decoration: none;
		transition: color var(--motion-fast);
	}
	.related-list a:hover {
		color: var(--accent-text);
	}

	/* --- Breakpoints ------------------------------------------------------ */

	@media (max-width: 1080px) {
		.article-head-main {
			grid-column: 1 / -1;
		}
		.article-facts {
			grid-column: 1 / -1;
			margin-top: var(--space-m);
		}
		.article-facts > div {
			display: inline-flex;
			justify-content: flex-start;
			gap: var(--space-2xs);
			margin-right: var(--space-m);
			border-bottom: 0;
		}
		.article-facts {
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-s);
			border-top: 0;
			border-bottom: 1px solid var(--line);
		}
	}

	@media (max-width: 900px) {
		.reading-grid {
			display: block;
		}
		.desktop-contents {
			display: none;
		}
		.mobile-contents {
			display: block;
