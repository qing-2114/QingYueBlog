---
// Visible connectors and motion share one route; endpoints stay outside node borders.
// Colours come from the --diagram-* tokens (see global.css) via CSS classes,
// because SVG presentation attributes cannot resolve var().
const routes = [
    { id: 'travel-input', d: 'M 144 182 H 160', kind: 'main' },
    { id: 'travel-context', d: 'M 279 182 H 315', kind: 'main' },
    { id: 'travel-model', d: 'M 434 182 H 470', kind: 'main' },
    { id: 'travel-finish', d: 'M 589 182 H 625', kind: 'main' },
    { id: 'travel-session', d: 'M 744 182 H 780', kind: 'main' },
    { id: 'travel-memory', d: 'M 220 146 V 108 Q 220 92 236 92 H 315', kind: 'feedback' },
    { id: 'travel-recall', d: 'M 375 126 V 145', kind: 'feedback' },
    { id: 'travel-reject', d: 'M 220 218 V 294 Q 220 310 236 310 H 315', kind: 'feedback' },
    { id: 'travel-strategy', d: 'M 375 276 V 219', kind: 'feedback' },
    { id: 'travel-action', d: 'M 530 218 V 275', kind: 'tool' },
    { id: 'travel-observe', d: 'M 589 310 H 625', kind: 'tool' },
    { id: 'travel-return', d: 'M 685 344 V 364 Q 685 380 669 380 H 471 Q 455 380 455 364 V 258 Q 455 242 471 242 H 498 Q 510 242 510 230 V 219', kind: 'tool' },
    { id: 'travel-next', d: 'M 840 146 V 62 Q 840 46 824 46 H 104 Q 88 46 88 62 V 145', kind: 'feedback' },
];
const kinds = ['main', 'tool', 'feedback'] as const;
---
<section class="project-lab" aria-labelledby="lab-title">
	<div class="lab-heading">
		<div><p class="eyebrow">1.3-EXPERIMENT / AGENT LOOP</p><h2 id="lab-title">旅行 Agent 真实执行链路</h2></div>
		<div class="run-state"><span class="run-dot" aria-hidden="true"></span><span id="run-label">单回合最多 5 步</span></div>
	</div>

	<p class="lab-summary">从旅行推荐出发，加入偏好记忆、多轮反馈与模拟票务；连续三次拒绝会触发策略调整。</p>

	<div class="trace-toolbar">
		<div class="trace-legend" aria-label="链路图图例">
			<span><i class="legend-line main" aria-hidden="true"></i>主执行链</span>
			<span><i class="legend-line tool" aria-hidden="true"></i>工具回环</span>
			<span><i class="legend-line feedback" aria-hidden="true"></i>反馈与策略支路</span>
		</div>
		<button class="play-toggle" type="button" aria-pressed="true">暂停演示</button>
	</div>

	<div class="trace-shell">
		<div class="trace-scroll" tabindex="0" role="region" aria-label="旅行 Agent 执行链路图，可横向滚动">
			<svg class="trace-map" viewBox="0 0 960 420" role="group" aria-labelledby="trace-title trace-desc">
				<title id="trace-title">旅行 Agent 的单回合工具循环与跨回合反馈循环</title>
				<desc id="trace-desc">用户消息先经过反馈分类、记忆检索与上下文组装。模型可以直接 Finish，也可以调用工具，并把 Observation 回灌给模型继续决策。回复写入会话状态，下一条用户反馈开始新回合；连续拒绝三次时，策略反思结果会注入上下文。</desc>
				<defs>
					<pattern id="trace-grid" width="30" height="30" patternUnits="userSpaceOnUse"><path class="diagram-grid-line" d="M 30 0 L 0 0 0 30" fill="none" stroke-width="1"></path></pattern>
					{kinds.map((kind) => (
						<marker id={`arrow-${kind}`} viewBox="0 0 10 10" refX="10" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path class={`arrow-${kind}`} d="M 0 0 L 10 5 L 0 10 z"></path></marker>
					))}
				</defs>

				<rect width="960" height="420" fill="url(#trace-grid)" opacity=".62"></rect>
				<text x="38" y="35" class="lane-title">TURN / 当前用户回合</text>
				<text x="38" y="365" class="lane-title">CONDITIONAL / 条件分支与工具回环</text>

				{routes.map((route) => <path id={route.id} d={route.d} class={`route-${route.kind}`} />)}
				<text x="607" y="166" class="route-label label-main">Finish</text>
				<text x="270" y="78" class="route-label label-feedback">每回合检索 1 次</text>
				<text x="284" y="249" class="route-label label-feedback">连续拒绝 × 3</text>
				<text x="564" y="249" class="route-label label-tool">Tool Call</text>
				<text x="586" y="405" class="route-label label-tool">Observation 回灌 · 继续决策</text>
				<text x="691" y="32" class="route-label label-feedback">下一条消息开启新回合</text>

				{routes.map((route, index) => (
					<g class="trace-packets" aria-hidden="true">
						<circle r="3" class={`packet packet-${route.kind}`}>
							<animateMotion dur="3.6s" begin={`${index * .3}s`} repeatCount="indefinite">
								<mpath href={`#${route.id}`} />
							</animateMotion>
						</circle>
					</g>
				))}

				<g class="diagram-node active" data-node="input" data-index="01" data-title="新消息进入" data-detail="接收本轮旅行请求；后续消息也可能是对上一条推荐的反馈。" data-files="session_agent.py" tabindex="0" role="button" aria-pressed="true" aria-label="01 新消息进入"><rect x="35" y="150" width="105" height="64" rx="0"></rect><text x="49" y="170" class="node-index">01 · INPUT</text><text x="88" y="193" class="node-label">新消息进入</text></g>
				<g class="diagram-node" data-node="feedback" data-index="02" data-title="识别反馈类型" data-detail="把消息标记为 NONE、ACCEPT 或 REJECT；首次消息固定为 NONE。" data-files="session_agent.py · classify_feedback" tabindex="0" role="button" aria-pressed="false" aria-label="02 反馈分类"><rect x="165" y="150" width="110" height="64" rx="0"></rect><text x="179" y="170" class="node-index">02 · ROUTE</text><text x="220" y="193" class="node-label">反馈分类</text></g>
				<g class="diagram-node support-node" data-node="memory" data-index="03" data-title="检索 V0 记忆" data-detail="使用当前输入与最近会话历史检索用户偏好；每个用户回合只检索一次。" data-files="memory_store.py" tabindex="0" role="button" aria-pressed="false" aria-label="03 检索 V0 记忆"><rect x="320" y="62" width="110" height="60" rx="0"></rect><text x="334" y="81" class="node-index">03 · MEMORY</text><text x="375" y="104" class="node-label">检索 V0 记忆</text></g>
				<g class="diagram-node" data-node="context" data-index="04" data-title="组装本轮上下文" data-detail="合并系统提示词、长期记忆、最近 12 条消息与当前策略，不把记忆重复写入循环历史。" data-files="agent.py · prompts/travel_agent.md" tabindex="0" role="button" aria-pressed="false" aria-label="04 组装上下文"><rect x="320" y="150" width="110" height="64" rx="0"></rect><text x="334" y="170" class="node-index">04 · CONTEXT</text><text x="375" y="193" class="node-label">组装上下文</text></g>
				<g class="diagram-node decision-node" data-node="model" data-index="05" data-title="模型生成 Thought / Action" data-detail="模型在每一步选择注册工具或返回 Finish；单回合最多执行 5 步。" data-files="agent.py · llm_client.py" tabindex="0" role="button" aria-pressed="false" aria-label="05 模型决策"><rect x="475" y="150" width="110" height="64" rx="0"></rect><text x="489" y="170" class="node-index">05 · DECIDE</text><text x="530" y="193" class="node-label">模型决策</text></g>
				<g class="diagram-node" data-node="output" data-index="08" data-title="Finish 生成回复" data-detail="模型输出 Finish[最终答案] 后结束当前 Agent Loop，并返回可展示答案。" data-files="agent.py · parse_action" tabindex="0" role="button" aria-pressed="false" aria-label="08 Finish 回复"><rect x="630" y="150" width="110" height="64" rx="0"></rect><text x="644" y="170" class="node-index">08 · FINISH</text><text x="685" y="193" class="node-label">生成回复</text></g>
				<g class="diagram-node" data-node="session" data-index="09" data-title="更新 SessionState" data-detail="保存用户消息、回复、最近拒绝、策略版本与 last_recommendation，等待下一轮。" data-files="session_agent.py · SessionState" tabindex="0" role="button" aria-pressed="false" aria-label="09 更新会话状态"><rect x="785" y="150" width="110" height="64" rx="0"></rect><text x="799" y="170" class="node-index">09 · SESSION</text><text x="840" y="193" class="node-label">更新会话</text></g>
				<g class="diagram-node support-node" data-node="reflection" data-index="10" data-title="条件策略反思" data-detail="连续 3 次明确拒绝时总结可执行约束，先更新策略，再生成本轮新推荐。" data-files="session_agent.py · _reflect" tabindex="0" role="button" aria-pressed="false" aria-label="10 条件策略反思"><rect x="320" y="280" width="110" height="60" rx="0"></rect><text x="334" y="299" class="node-index">10 · REFLECT</text><text x="375" y="322" class="node-label">策略反思</text></g>
				<g class="diagram-node tool-node" transform="translate(-135 0)" data-node="tools" data-index="06" data-title="执行注册工具" data-detail="分发天气、景点、查票、备选与购票工具；购票要求用户明确确认。" data-files="tools.py · available_tools" tabindex="0" role="button" aria-pressed="false" aria-label="06 执行注册工具"><rect x="610" y="280" width="110" height="60" rx="0"></rect><text x="624" y="299" class="node-index">06 · ACTION</text><text x="665" y="322" class="node-label">执行工具</text></g>
				<g class="diagram-node tool-node" transform="translate(-125 0)" data-node="observation" data-index="07" data-title="Observation 回灌" data-detail="工具结果或解析错误被追加到本轮 prompt_history，再交给模型继续决策。" data-files="agent.py · run_agent" tabindex="0" role="button" aria-pressed="false" aria-label="07 Observation 回灌"><rect x="755" y="280" width="110" height="60" rx="0"></rect><text x="769" y="299" class="node-index">07 · OBSERVE</text><text x="810" y="322" class="node-label">结果回灌</text></g>
			</svg>
		</div>

		<div class="trace-detail" aria-live="off" aria-atomic="true"><span class="detail-index" id="detail-index">01</span><div><strong id="detail-title">新消息进入</strong><p id="detail-copy">接收本轮旅行请求；后续消息也可能是对上一条推荐的反馈。</p></div><code id="detail-files">session_agent.py</code></div>
	</div>

	<p class="trace-note"><strong>读图方式：</strong>橙色是当前回合的必经主链，蓝色是模型与工具之间可重复的 Agent Loop，绿色是跨回合反馈；反思只在连续 3 次明确拒绝时触发。</p>
</section>

<script>
    document.querySelectorAll<HTMLElement>('.project-lab').forEach((section) => {
        const order = ['input', 'feedback', 'memory', 'context', 'model', 'tools', 'observation', 'output', 'session', 'reflection'];
        const nodes = [...section.querySelectorAll<SVGGElement>('.diagram-node')];
        const svg = section.querySelector<SVGSVGElement>('.trace-map')!;
        const toggle = section.querySelector<HTMLButtonElement>('.play-toggle')!;
        const detail = section.querySelector<HTMLElement>('.trace-detail')!;
        const detailIndex = section.querySelector('#detail-index')!;
        const detailTitle = section.querySelector('#detail-title')!;
        const detailCopy = section.querySelector('#detail-copy')!;
        const detailFiles = section.querySelector('#detail-files')!;
        const runLabel = section.querySelector('#run-label')!;
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
        let current = 0;
        let playing = !reduced.matches;
        let visible = false;
        let timer: number | undefined;

        const selectNode = (id: string, manual = false) => {
            const node = nodes.find((item) => item.dataset.node === id);
            if (!node) return;
            if (manual) {
                playing = false;
                syncPlayback();
            }
            current = Math.max(0, order.indexOf(id));
            nodes.forEach((item) => {
                const selected = item === node;
                item.classList.toggle('active', selected);
                item.setAttribute('aria-pressed', String(selected));
            });
            detailIndex.textContent = node.dataset.index ?? '';
            detailTitle.textContent = node.dataset.title ?? '';
            detailCopy.textContent = node.dataset.detail ?? '';
            detailFiles.textContent = node.dataset.files ?? '';
            if (manual) runLabel.textContent = node.dataset.title ?? '';
        };

        const syncPlayback = () => {
            const running = playing && visible && !document.hidden;
            toggle.textContent = playing ? '暂停演示' : '播放演示';
            toggle.setAttribute('aria-pressed', String(playing));
            section.classList.toggle('is-paused', !running);
            detail.setAttribute('aria-live', playing ? 'off' : 'polite');
            if (running) {
                svg.unpauseAnimations();
                if (timer === undefined) {
                    timer = window.setInterval(() => {
                        selectNode(order[(current + 1) % order.length]);
                    }, 4000);
                }
            } else {
                svg.pauseAnimations();
                if (timer !== undefined) {
                    window.clearInterval(timer);
                    timer = undefined;
                }
            }
        };

        nodes.forEach((node) => {
            node.addEventListener('click', () => selectNode(node.dataset.node ?? '', true));
            node.addEventListener('keydown', (event) => {
                if (event.key === 'Enter' || event.key === ' ') {
                    event.preventDefault();
                    selectNode(node.dataset.node ?? '', true);
                }
            });
        });
        toggle.addEventListener('click', () => {
            playing = !playing;
            syncPlayback();
        });
        const observer = new IntersectionObserver((entries) => {
            visible = entries[0].isIntersecting;
            syncPlayback();
        });
        observer.observe(section);
        document.addEventListener('visibilitychange', syncPlayback);
        reduced.addEventListener('change', () => {
            if (reduced.matches) playing = false;
            syncPlayback();
        });
        window.addEventListener('pagehide', () => {
            if (timer !== undefined) window.clearInterval(timer);
            timer = undefined;
            svg.pauseAnimations();
        });
        window.addEventListener('pageshow', syncPlayback);
        syncPlayback();
    });
</script>

<style>
	.project-lab {
		width: 100%;
		max-width: 100%;
		min-width: 0;
		margin: var(--space-xl) 0;
		padding: var(--space-m);
		overflow: hidden;
		border: 1px solid var(--line);
		background: var(--surface);
		transition: background-color var(--motion-base), border-color var(--motion-base);
	}
	.lab-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-s);
		margin-bottom: var(--space-2xs);
	}
	.eyebrow {
		margin: 0 0 var(--space-3xs);
		color: var(--accent-text);
		font-size: 0.66rem;
		font-weight: 500;
	}
	.lab-heading h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--step-1);
		font-weight: 400;
	}
	.run-state {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3xs);
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: var(--step--2);
		white-space: nowrap;
	}
	.run-dot {
		width: 7px;
		height: 7px;
		background: var(--success);
	}
	.lab-summary {
		margin: 0 0 var(--space-s);
		color: var(--muted);
		font-size: var(--step--2);
		line-height: 1.7;
	}
	.trace-legend {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2xs) var(--space-s);
		margin: 0;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: var(--step--2);
		letter-spacing: 0.04em;
	}
	.trace-legend span {
		display: inline-flex;
		align-items: center;
		gap: 0.38rem;
	}
	.legend-line {
		display: inline-block;
		width: 20px;
		height: 0;
		border-top: 2px solid;
	}
	.legend-line.main {
		border-color: var(--diagram-main);
	}
	.legend-line.tool {
		border-color: var(--diagram-loop);
		border-top-style: dashed;
	}
	.legend-line.feedback {
		border-color: var(--diagram-finish);
		border-top-style: dotted;
	}
	.trace-shell {
		overflow: hidden;
		border: 1px solid var(--line);
		background: var(--surface-sunk);
		transition: background-color var(--motion-base);
	}
	.trace-scroll {
		width: 100%;
		max-width: 100%;
		overflow-x: auto;
		overscroll-behavior-inline: contain;
	}
	.trace-scroll:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: -2px;
	}
	.trace-map {
		display: block;
		width: 100%;
		min-width: 820px;
	}

	/* Diagram palette — every colour is a token, so the diagram follows the
	   theme. SVG attributes cannot read var(), hence the classes. */
	.diagram-grid-line {
		stroke: var(--diagram-grid);
	}
	.lane-title {
		fill: var(--diagram-lane);
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.16em;
	}
	.arrow-main {
		fill: var(--diagram-main);
	}
	.arrow-tool {
		fill: var(--diagram-loop);
	}
	.arrow-feedback {
		fill: var(--diagram-finish);
	}

	.route-main,
	.route-tool,
	.route-feedback {
		fill: none;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.route-main {
		stroke: var(--diagram-main);
		marker-end: url(#arrow-main);
	}
	.route-tool {
		stroke: var(--diagram-loop);
		stroke-dasharray: 4 6;
		marker-end: url(#arrow-tool);
	}
	.route-feedback {
		stroke: var(--diagram-finish);
		stroke-dasharray: 2 6;
		marker-end: url(#arrow-feedback);
	}
	.route-return,
	.route-session {
		stroke-width: 1.5;
	}
	.route-label {
		font-family: var(--font-mono);
		font-size: 10px;
		text-anchor: middle;
		paint-order: stroke;
		stroke: var(--surface-sunk);
		stroke-width: 5px;
		stroke-linejoin: round;
	}
	.label-main {
		fill: var(--diagram-main-ink);
	}
	.label-tool {
		fill: var(--diagram-loop-ink);
	}
	.label-feedback {
		fill: var(--diagram-finish-ink);
	}
	.packet-main {
		fill: var(--diagram-main);
	}
	.packet-tool {
		fill: var(--diagram-loop);
	}
	.packet-feedback {
		fill: var(--diagram-finish);
	}

	.diagram-node {
		cursor: pointer;
		outline: none;
	}
	.diagram-node rect {
		fill: var(--surface);
		stroke: var(--line);
		stroke-width: 1.4;
		transition: fill var(--motion-fast), stroke var(--motion-fast);
	}
	.diagram-node text {
		font-family: var(--font-atkinson);
		pointer-events: none;
	}
	.node-index {
		fill: var(--muted);
		font-family: var(--font-mono);
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.06em;
	}
	.node-label {
		fill: var(--ink);
		font-size: 13px;
		font-weight: 700;
		text-anchor: middle;
	}
	/* Node kind tints the border only; the fill stays neutral so the active
	   node's accent fill reads as the one live element on the grid. */
	.decision-node rect {
		stroke: var(--diagram-main);
		stroke-width: 2;
	}
	.tool-node rect {
		stroke: var(--diagram-loop);
	}
	.support-node rect {
		stroke: var(--diagram-finish);
	}
	.diagram-node:hover rect {
		stroke: var(--line-strong);
	}
	.diagram-node.active rect,
	.diagram-node:focus rect {
		fill: var(--accent-soft);
		stroke: var(--accent);
		stroke-width: 2.4;
	}
	.diagram-node.active .node-label {
		fill: var(--accent-text);
	}

	.trace-detail {
		display: flex;
		align-items: center;
		gap: var(--space-xs);
		min-height: 86px;
		padding: var(--space-2xs) var(--space-s);
		border-top: 1px solid var(--line);
		background: var(--surface);
		transition: background-color var(--motion-base);
	}
	.detail-index {
		color: var(--accent-text);
		font-family: var(--font-mono);
		font-size: var(--step--2);
		font-weight: 700;
	}
	.trace-detail div {
		flex: 1;
		min-width: 0;
	}
	.trace-detail strong {
		font-size: var(--step--2);
	}
	.trace-detail p {
		margin: 0.1rem 0 0;
		color: var(--muted);
		font-size: var(--step--2);
		line-height: 1.55;
	}
	.trace-detail code {
		max-width: 38%;
		color: var(--accent-text);
		background: transparent;
		font-size: 0.7rem;
		overflow-wrap: anywhere;
	}
	.trace-note {
		margin: var(--space-2xs) 0 0;
		color: var(--muted);
		font-size: 0.7rem;
		line-height: 1.65;
	}
	.trace-note strong {
		color: var(--ink);
	}

	.trace-toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-s);
		margin-bottom: var(--space-xs);
	}
	.play-toggle {
		flex-shrink: 0;
		min-height: 44px;
		padding: 0.35rem 0.8rem;
		color: var(--accent-text);
		background: transparent;
		border: 1px solid var(--line);
		font-size: var(--step--2);
		transition: color var(--motion-fast), border-color var(--motion-fast);
