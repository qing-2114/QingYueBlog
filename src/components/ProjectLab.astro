	</div>

	<p class="trace-note"><strong>读图方式：</strong>蓝色是当前回合的必经主链，靛蓝色是模型与工具之间可重复的 Agent Loop，绿色是跨回合反馈；反思只在连续 3 次明确拒绝时触发。</p>
</section>

<script>
	const order = ['input', 'feedback', 'memory', 'context', 'model', 'tools', 'observation', 'output', 'session', 'reflection'];
	const nodes = [...document.querySelectorAll<SVGGElement>('.diagram-node')];
	const detailIndex = document.querySelector('#detail-index');
	const detailTitle = document.querySelector('#detail-title');
	const detailCopy = document.querySelector('#detail-copy');
	const detailFiles = document.querySelector('#detail-files');
	const runLabel = document.querySelector('#run-label');
	let current = 0;
	const selectNode = (id: string, announce = true) => {
		const node = nodes.find((item) => item.dataset.node === id);
		if (!node || !detailIndex || !detailTitle || !detailCopy || !detailFiles) return;
		current = order.indexOf(id);
		nodes.forEach((item) => item.classList.toggle('active', item === node));
		detailIndex.textContent = node.dataset.index ?? '';
		detailTitle.textContent = node.dataset.title ?? '';
		detailCopy.textContent = node.dataset.detail ?? '';
		detailFiles.textContent = node.dataset.files ?? '';
		if (announce && runLabel) runLabel.textContent = node.dataset.title ?? '';
	};
	nodes.forEach((node) => {
		node.addEventListener('click', () => selectNode(node.dataset.node ?? ''));
		node.addEventListener('keydown', (event) => {
			if (event.key === 'Enter' || event.key === ' ') {
				event.preventDefault();
				selectNode(node.dataset.node ?? '');
			}
		});
	});
	if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		window.setInterval(() => selectNode(order[(current + 1) % order.length], false), 4000);
	}
</script>

