---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import Icon from './Icon.astro';
import { articleCover, basePath, readingMinutes } from '../utils/content';

interface Props { post: CollectionEntry<'blog'>; compact?: boolean; index?: string; }
const { post, compact = false, index } = Astro.props;
const cover = articleCover(post);
const Heading = compact ? 'h2' : 'h3';
const href = `${basePath}blog/${post.id}/`;
---
<article class:list={['article-preview', { compact }]} data-reveal>
  <a class="cover" href={href} tabindex="-1" aria-hidden="true">
    {cover ? <Image src={cover} alt="" width={720} height={450} widths={[360, 720]} sizes={compact ? '(max-width: 720px) 100vw, 240px' : '(max-width: 720px) 100vw, 33vw'} loading="lazy" /> : <span class="cover-type">FIELD NOTES</span>}
  </a>
  <div class="preview-copy">
    <div class="article-meta">
      {index && <span class="preview-index">{index}</span>}
      <span>{post.data.category}</span>
      <FormattedDate date={post.data.pubDate} />
    </div>
    <Heading><a href={href}>{post.data.title}</a></Heading>
    {compact && <p>{post.data.description}</p>}
    <div class="preview-bottom">
      <span class="preview-reading"><Icon name="clock" size={14} /> {readingMinutes(post.body)} min<span class="sr-only">阅读</span></span>
      <a class="preview-link" href={href} aria-label={`阅读：${post.data.title}`}><span aria-hidden="true">↗</span></a>
    </div>
  </div>
</article>

<style>
  .article-preview {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* Images sit on a plate: artwork stays legible when the page goes dark. */
  .cover {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--plate);
    border: 1px solid var(--line);
    transition: border-color var(--motion-fast);
  }
  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--motion-slow);
  }
  .cover-type {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.2em;
  }

  .preview-copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding-top: var(--space-s);
  }
  .article-meta {
    margin-bottom: var(--space-2xs);
  }
  .preview-index {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  h2,
  h3 {
    font-size: var(--step-1);
    line-height: 1.42;
    letter-spacing: -0.015em;
  }
  h2 a,
  h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  p {
    color: var(--muted);
    font-size: var(--step--1);
    line-height: 1.72;
    /* Keep the copy block even so a 3-up row aligns at the bottom edge. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }
  .preview-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    margin-top: auto;
    padding-top: var(--space-2xs);
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.04em;
  }
  .preview-reading {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
  }
  .preview-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    font-size: var(--step-0);
    gap: var(--space-3xs);
    min-height: 44px;
    color: var(--accent-text);
    text-decoration: none;
  }
  .preview-link > span {
    display: inline-block;
    transition: transform var(--motion-base);
  }

  .article-preview:focus-within .cover {
    border-color: var(--accent);
  }
  .article-preview:focus-within .cover :global(img) {
    transform: scale(1.03);
  }
  .article-preview:focus-within .preview-link > span {
    transform: translate(3px, -3px);
  }
  @media (hover: hover) {
    .article-preview:hover .cover {
      border-color: var(--accent);
    }
    .article-preview:hover .cover :global(img) {
      transform: scale(1.03);
    }
    .article-preview:hover h2 a,
    .article-preview:hover h3 a {
      color: var(--accent-text);
    }
    .article-preview:hover .preview-link > span {
      transform: translate(3px, -3px);
    }
  }

  /* Compact — the archive row. Image left, copy right, hairline between. */
  .compact {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    align-items: start;
    gap: var(--space-m);
  }
  .compact .preview-copy {
    padding-top: 0;
  }
  .compact p {
    -webkit-line-clamp: 1;
    line-clamp: 1;
  }

  @media (max-width: 720px) {
    .compact {
      grid-template-columns: 1fr;
      gap: var(--space-s);
    }
    h2,
    h3 {
      font-size: var(--step-1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cover :global(img),
    .preview-link > span {
      transition: none;
    }
    .article-preview:is(:hover, :focus-within) .cover :global(img),
    .article-preview:is(:hover, :focus-within) .preview-link > span {
      transform: none;
    }
  }
</style>
