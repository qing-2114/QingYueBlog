	.react-diagram-node:hover rect { fill: rgba(91,163,224,.1); }
	.react-diagram-node.active rect, .react-diagram-node:focus rect { fill: rgba(91,163,224,.16); stroke: var(--accent); stroke-width: 2.4; filter: drop-shadow(0 0 6px rgba(40,127,195,.3)); }
	.trace-detail { display: flex; align-items: center; gap: .7rem; min-height: 70px; padding: .7rem .9rem; border-top: 1px solid var(--line); background: rgba(255,255,255,.62); }
