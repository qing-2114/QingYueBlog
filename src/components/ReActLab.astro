	@keyframes blink { 50% { opacity: .35; } }
	@media (prefers-reduced-motion: reduce) { .trace-packets, .run-dot { display: none; animation: none; } }
	@media (max-width: 700px) { .react-lab { padding: 1rem; } .lab-heading { display: block; } .lab-heading h2 { font-size: 1.3rem; } .run-state { margin-top: .5rem; } .trace-map { width: 820px; min-width: 820px; } .trace-detail { align-items: flex-start; flex-wrap: wrap; } .trace-detail code { width: 100%; margin-left: 1.4rem; white-space: normal; } }
</style>
