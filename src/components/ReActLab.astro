<section class="react-lab" aria-labelledby="react-lab-title">
	<div class="lab-heading">
		<div><p class="eyebrow">4-EXPERIMENT / REACT AGENT</p><h2 id="react-lab-title">ReAct Agent 动态执行链路</h2></div>
		<div class="run-state"><span class="run-dot" aria-hidden="true"></span><span id="react-run-label">单回合最多 5 步</span></div>
	</div>

	<div class="trace-legend" aria-label="链路图图例">
		<span><i class="legend-line main" aria-hidden="true"></i>单步主链</span>
		<span><i class="legend-line tool" aria-hidden="true"></i>工具调用回环</span>
		<span><i class="legend-line finish" aria-hidden="true"></i>Finish 结束分支</span>
	</div>

	<div class="trace-shell">
		<div class="trace-scroll" tabindex="0" aria-label="ReAct Agent 执行链路图，可横向滚动">
			<svg class="trace-map" viewBox="0 0 960 420" role="img" aria-labelledby="trace-title trace-desc">
				<title id="trace-title">ReAct Agent 的 Thought、Action 和 Observation 循环</title>
				<desc id="trace-desc">用户问题被组装为包含工具清单和历史记录的 ReAct 提示词。模型生成 Thought 和 Action，解析后可以 Finish 返回答案，或调用注册工具。工具结果作为 Observation 追加到历史，再开始下一步，最多五步。</desc>
				<defs>
					<pattern id="react-trace-grid" width="30" height="30" patternUnits="userSpaceOnUse"><path d="M 30 0 L 0 0 0 30" fill="none" stroke="rgba(138,180,224,.17)" stroke-width="1"></path></pattern>
					<filter id="react-trace-glow" x="-100%" y="-100%" width="300%" height="300%"><feGaussianBlur stdDeviation="4" result="blur"></feGaussianBlur><feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge></filter>
					<marker id="react-arrow-main" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="#287fc3"></path></marker>
					<marker id="react-arrow-tool" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="#5b7fba"></path></marker>
					<marker id="react-arrow-finish" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="#3c9b76"></path></marker>
					<path id="react-main-route" d="M 85 182 L 250 182 L 420 182 L 590 182 L 820 182"></path>
					<path id="react-tool-route" d="M 570 214 C 570 250, 590 275, 620 300 L 750 300 C 775 360, 535 372, 445 330 C 360 80, 270 100, 250 150"></path>
				</defs>

				<rect width="960" height="420" fill="url(#react-trace-grid)" opacity=".62"></rect>
				<text x="38" y="35" class="lane-title">TURN / 当前 ReAct 回合</text>
				<text x="38" y="264" class="lane-title">LOOP / Action 与 Observation 回环</text>

				<path d="M 130 182 L 175 182" class="route-main"></path>
				<path d="M 325 182 L 365 182" class="route-main"></path>
				<path d="M 475 182 L 515 182" class="route-main"></path>
				<path d="M 625 182 L 690 182" class="route-finish"></path>
				<text x="655" y="166" class="route-label finish-label">Finish</text>

				<path d="M 570 214 C 570 250, 590 275, 620 300" class="route-tool"></path>
				<path d="M 710 300 L 750 300" class="route-tool"></path>
				<path d="M 860 300 C 885 370, 535 382, 445 330" class="route-tool"></path>
				<path d="M 445 270 C 360 74, 270 100, 250 150" class="route-tool route-return"></path>
				<text x="595" y="253" class="route-label tool-label">Action</text>
				<text x="730" y="284" class="route-label tool-label">调用</text>
				<text x="650" y="368" class="route-label tool-label">Observation</text>
				<text x="604" y="76" class="route-label tool-label">写入 history 后进入下一步</text>

				<g class="trace-packets" filter="url(#react-trace-glow)" aria-hidden="true"><circle r="4.5" fill="#287fc3"><animateMotion dur="6.8s" repeatCount="indefinite"><mpath href="#react-main-route"></mpath></animateMotion></circle><circle r="4" fill="#5b7fba"><animateMotion dur="5.2s" begin="1.1s" repeatCount="indefinite"><mpath href="#react-tool-route"></mpath></animateMotion></circle></g>

				<g class="react-diagram-node active" data-node="input" data-index="01" data-title="接收问题" data-detail="run(question) 开始一轮任务，并在进入循环前清空本轮 history。" data-files="ReAct/agent.py · run" tabindex="0" role="button" aria-label="01 接收问题"><rect x="40" y="150" width="90" height="64" rx="14"></rect><text x="52" y="170" class="node-index">01 · INPUT</text><text x="85" y="193" class="node-label">接收问题</text></g>
				<g class="react-diagram-node context-node" data-node="prompt" data-index="02" data-title="构造 ReAct Prompt" data-detail="把问题、工具描述和已有 Observation 一起填入提示词模板。" data-files="ReAct/agent.py · prompts.py" tabindex="0" role="button" aria-label="02 构造 ReAct Prompt"><rect x="175" y="150" width="150" height="64" rx="14"></rect><text x="189" y="170" class="node-index">02 · CONTEXT</text><text x="250" y="193" class="node-label">构造 ReAct Prompt</text></g>
				<g class="react-diagram-node decision-node" data-node="think" data-index="03" data-title="模型生成 Thought / Action" data-detail="HelloAgentsLLM.think() 返回模型输出；提示词要求严格的 Thought 与 Action 格式。" data-files="ReAct/agent.py · llm_client.py" tabindex="0" role="button" aria-label="03 模型生成 Thought 和 Action"><rect x="365" y="150" width="110" height="64" rx="14"></rect><text x="379" y="170" class="node-index">03 · THINK</text><text x="420" y="193" class="node-label">模型决策</text></g>
				<g class="react-diagram-node" data-node="parse" data-index="04" data-title="解析 Action" data-detail="提取 Thought 和 Action；Action 只能是 工具名[输入] 或 Finish[最终答案]。" data-files="ReAct/agent.py · _parse_output" tabindex="0" role="button" aria-label="04 解析 Action"><rect x="515" y="150" width="110" height="64" rx="14"></rect><text x="529" y="170" class="node-index">04 · PARSE</text><text x="570" y="193" class="node-label">解析 Action</text></g>
				<g class="react-diagram-node finish-node" data-node="finish" data-index="05" data-title="Finish 返回答案" data-detail="检测到 Finish[最终答案] 后，立即结束当前回合并将答案返回给用户。" data-files="ReAct/agent.py · run" tabindex="0" role="button" aria-label="05 Finish 返回答案"><rect x="690" y="150" width="150" height="64" rx="14"></rect><text x="704" y="170" class="node-index">05 · FINISH</text><text x="765" y="193" class="node-label">返回最终答案</text></g>
				<g class="react-diagram-node tool-node" data-node="executor" data-index="06" data-title="查找注册工具" data-detail="ToolExecutor 依据 Action 中的工具名称取得对应函数；未找到时生成错误 Observation。" data-files="ReAct/tools.py · ToolExecutor" tabindex="0" role="button" aria-label="06 查找注册工具"><rect x="555" y="270" width="155" height="60" rx="14"></rect><text x="569" y="289" class="node-index">06 · ACTION</text><text x="632" y="312" class="node-label">查找注册工具</text></g>
				<g class="react-diagram-node tool-node" data-node="search" data-index="07" data-title="执行搜索工具" data-detail="当前注册 search：有本地 SERPAPI_API_KEY 时才请求 SerpApi，并返回直接答案、知识图谱或前三条摘要。" data-files="ReAct/tools.py · search" tabindex="0" role="button" aria-label="07 执行搜索工具"><rect x="750" y="270" width="110" height="60" rx="14"></rect><text x="764" y="289" class="node-index">07 · TOOL</text><text x="805" y="312" class="node-label">网页搜索</text></g>
				<g class="react-diagram-node support-node" data-node="observe" data-index="08" data-title="追加 Observation" data-detail="工具结果或解析错误写入 history，下一步构造 Prompt 时由模型参考。" data-files="ReAct/agent.py · history" tabindex="0" role="button" aria-label="08 追加 Observation"><rect x="390" y="270" width="110" height="60" rx="14"></rect><text x="404" y="289" class="node-index">08 · OBSERVE</text><text x="445" y="312" class="node-label">结果回灌</text></g>
			</svg>
		</div>

		<div class="trace-detail" aria-live="polite"><span class="react-detail-index" id="react-detail-index">01</span><div><strong id="react-detail-title">接收问题</strong><p id="react-detail-copy">run(question) 开始一轮任务，并在进入循环前清空本轮 history。</p></div><code id="react-detail-files">ReAct/agent.py · run</code></div>
	</div>

	<p class="trace-note"><strong>读图方式：</strong>蓝色是每一步的主执行链；模型选择工具时走靛蓝色回环，Observation 被写入 history 后重新构造 Prompt；绿色 Finish 分支直接返回答案。整个循环最多执行 5 步。</p>
</section>

<script>
	const order = ['input', 'prompt', 'think', 'parse', 'executor', 'search', 'observe', 'finish'];
	const nodes = [...document.querySelectorAll<SVGGElement>('.react-diagram-node')];
	const detailIndex = document.querySelector('#react-detail-index');
	const detailTitle = document.querySelector('#react-detail-title');
	const detailCopy = document.querySelector('#react-detail-copy');
	const detailFiles = document.querySelector('#react-detail-files');
	const runLabel = document.querySelector('#react-run-label');
	let current = 0;
	const selectNode = (id: string, announce = true) => {
		const node = nodes.find((item) => item.dataset.node === id);
		if (!node || !detailIndex || !detailTitle || !detailCopy || !detailFiles) return;
		current = order.indexOf(id);
		nodes.forEach((item) => item.classList.toggle('active', item === node));
		detailIndex.textContent = node.dataset.index ?? '';
		detailTitle.textContent = node.dataset.title ?? '';
		detailCopy.textContent = node.dataset.detail ?? '';
		detailFiles.textContent = node.dataset.files ?? '';
		if (announce && runLabel) runLabel.textContent = node.dataset.title ?? '';
	};
	nodes.forEach((node) => {
		node.addEventListener('click', () => selectNode(node.dataset.node ?? ''));
		node.addEventListener('keydown', (event) => {
			if (event.key === 'Enter' || event.key === ' ') {
				event.preventDefault();
				selectNode(node.dataset.node ?? '');
			}
		});
	});
	if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		window.setInterval(() => selectNode(order[(current + 1) % order.length], false), 4000);
	}
</script>

