---
// The button ships with a neutral label; scripts/theme.ts corrects it against
// the theme resolved in <head> and keeps it in sync afterwards.
---
<button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="切换主题">
  <svg class="icon-sun" aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square">
    <circle cx="12" cy="12" r="4.2"></circle>
    <path d="M12 1.6v3M12 19.4v3M1.6 12h3M19.4 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M19.4 4.6l-2.1 2.1M6.7 17.3l-2.1 2.1"></path>
  </svg>
  <svg class="icon-moon" aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square">
    <path d="M20.5 14.2A8.6 8.6 0 0 1 9.8 3.5a8.6 8.6 0 1 0 10.7 10.7Z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    align-self: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 1px solid var(--line);
    color: var(--muted);
    background: transparent;
    transition: color var(--motion-fast), border-color var(--motion-fast),
      background-color var(--motion-fast);
  }
  .theme-toggle:hover {
    color: var(--accent-text);
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .theme-toggle svg {
    grid-area: 1 / 1;
    transition: opacity var(--motion-base), transform var(--motion-base);
  }
  /* Light theme shows the moon (the action available), dark shows the sun. */
  .icon-moon {
    opacity: 0;
    transform: rotate(-45deg) scale(0.6);
  }
  .icon-sun {
    opacity: 1;
    transform: none;
  }
  :global(:root[data-theme='dark']) .icon-moon {
    opacity: 1;
    transform: none;
  }
  :global(:root[data-theme='dark']) .icon-sun {
    opacity: 0;
    transform: rotate(45deg) scale(0.6);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .icon-moon {
      opacity: 1;
      transform: none;
    }
    :global(:root:not([data-theme])) .icon-sun {
      opacity: 0;
      transform: rotate(45deg) scale(0.6);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .theme-toggle svg {
      transition: none;
    }
  }
</style>
