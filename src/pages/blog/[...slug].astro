---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { byDate, readingMinutes } from '../../utils/content';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).sort(byDate);
	const asLink = (entry: CollectionEntry<'blog'>) => ({ id: entry.id, title: entry.data.title });
	return posts.map((post, index) => ({
		params: { slug: post.id },
		props: {
			post,
			previous: index < posts.length - 1 ? asLink(posts[index + 1]) : undefined,
			next: index > 0 ? asLink(posts[index - 1]) : undefined,
			related: posts.filter((entry) => entry.id !== post.id && entry.data.category === post.data.category)
				.slice(0, 3).map(asLink),
		},
	}));
}

type Props = {
	post: CollectionEntry<'blog'>;
	previous?: { id: string; title: string };
	next?: { id: string; title: string };
	related: { id: string; title: string }[];
};

const { post, previous, next, related } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPost {...post.data} headings={headings} readingMinutes={readingMinutes(post.body)} previous={previous} next={next} related={related}>
	<Content />
</BlogPost>
