---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ArticlePreview from '../components/ArticlePreview.astro';
import ExperimentFlow from '../components/ExperimentFlow.astro';
import { planFlow } from '../data/experiment-flows';
import workbench from '../assets/grok-build-web/workbench.png';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { articleCover, basePath, byDate, readingMinutes, topics, topicHref } from '../utils/content';

const posts = (await getCollection('blog')).sort(byDate);
const projects = await getCollection('projects');
const latest = posts[0];
const latestCover = latest && articleCover(latest);
const agentProject = projects.find((project) => project.id === 'my-hello-agent');
const productProject = projects.find((project) => project.id === 'grok-build-web');

const pad = (value: number) => String(value).padStart(2, '0');
const topicCount = (category: string) => posts.filter((post) => post.data.category === category).length;

// The masthead rail. Numbers the reader can check, not decoration.
const stats = [
  { key: 'FIELD NOTES', value: pad(posts.length), detail: '篇文章' },
  { key: 'PROJECTS', value: pad(projects.length), detail: '个项目' },
  { key: 'TOPICS', value: pad(topics.length), detail: '个方向' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
  <body>
    <Header />
    <main class="home" id="main-content">

      <!-- Masthead: the headline holds seven columns, the rail holds five.
           Asymmetry is the point — this is a masthead, not a centered hero. -->
      <section class="masthead" aria-labelledby="hero-title">
        <div class="grid">
          <div class="masthead-copy">
            <p class="eyebrow">QINGYUE&nbsp;/&nbsp;FIELD&nbsp;NOTES&nbsp;/&nbsp;{new Date().getFullYear()}</p>
            <h1 id="hero-title">让想法落地，<br />让探索留下痕迹。</h1>
            <p class="masthead-lede">你好，我是清月。在 AI、机器人与代码之间，把好奇心变成可以运行的实验，也把过程写成值得回看的记录。</p>
            <div class="masthead-actions">
              <a class="button primary" href={`${basePath}blog/`}>从一篇文章开始 <span aria-hidden="true">→</span></a>
              <a class="text-link" href={`${basePath}projects/`}>看看我在做什么 <span aria-hidden="true">→</span></a>
            </div>
          </div>

          <aside class="masthead-rail" aria-label="站点概览">
            <dl class="stat-list">
              {stats.map((stat) => (
                <div>
                  <dt>{stat.key}</dt>
                  <dd><span class="stat-value">{stat.value}</span><span class="stat-detail">{stat.detail}</span></dd>
                </div>
              ))}
            </dl>
            {latest && (
              <div class="rail-latest">
                <p class="eyebrow label-plain">最近更新</p>
                <a href={`${basePath}blog/${latest.id}/`}>
                  <span class="rail-date"><FormattedDate date={latest.data.pubDate} /> · {latest.data.category}</span>
                  <strong>{latest.data.title}</strong>
                  <span class="rail-reading">约 {readingMinutes(latest.body)} 分钟 <span aria-hidden="true">→</span></span>
                </a>
              </div>
            )}
          </aside>
        </div>
      </section>

      <!-- Topic index: a table of contents, numbered like a drawing set. -->
      <nav class="topic-index" aria-label="按主题阅读">
        <div class="index-head">
          <p class="eyebrow">目录 / INDEX</p>
          <span class="index-hint">选择一个方向开始阅读</span>
        </div>
        <ol class="topic-rows">
          {topics.map((topic) => (
            <li>
              <a href={topicHref(topic.category)}>
                <span class="topic-index-num">{topic.index}</span>
                <span class="topic-label">{topic.label}</span>
                <span class="topic-subtitle">{topic.subtitle}</span>
                <span class="topic-count">{pad(topicCount(topic.category))}</span>
                <span class="topic-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      {latest && latestCover && (
        <section class="feature" aria-labelledby="feature-title">
          <div class="section-heading">
            <div>
              <p class="eyebrow">01 / 近期发布</p>
              <h2 id="feature-title">最近的一页</h2>
            </div>
            <a class="text-link" href={`${basePath}blog/`}>全部文章 <span aria-hidden="true">→</span></a>
          </div>
          <div class="grid feature-grid">
            <a class="feature-image" href={`${basePath}blog/${latest.id}/`} tabindex="-1" aria-hidden="true">
              <Image src={latestCover} alt="" width={1100} height={690} widths={[560, 1100]} sizes="(max-width: 1080px) 100vw, 58vw" loading="eager" />
            </a>
            <div class="feature-copy">
              <div class="article-meta">
                <span>{latest.data.category}</span>
                <FormattedDate date={latest.data.pubDate} />
                <span>约 {readingMinutes(latest.body)} 分钟</span>
              </div>
              <h3><a href={`${basePath}blog/${latest.id}/`}>{latest.data.title}</a></h3>
              <p>{latest.data.description}</p>
              <a class="text-link" href={`${basePath}blog/${latest.id}/`}>翻开这篇记录 <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </section>
      )}

      <section class="writing" aria-labelledby="writing-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">02 / FIELD NOTES</p>
            <h2 id="writing-title">写下来的思考</h2>
          </div>
          <a class="text-link" href={`${basePath}blog/`}>全部文章 <span aria-hidden="true">→</span></a>
        </div>
        <div class="articles-grid">
          {posts.slice(1, 4).map((post, i) => <ArticlePreview post={post} index={pad(i + 2)} />)}
        </div>
      </section>

      {agentProject && (
        <section class="lab" aria-labelledby="lab-title">
          <div class="section-heading">
            <div>
              <p class="eyebrow">03 / EXPERIMENT IN PROGRESS</p>
              <h2 id="lab-title">在运行中理解</h2>
            </div>
            <a class="text-link" href={`${basePath}projects/my-hello-agent/`}>进入实验室 <span aria-hidden="true">→</span></a>
          </div>
          <div class="lab-intro">
            <div>
              <span class="lab-label">{agentProject.data.statusLabel} / {agentProject.data.title}</span>
              <p>从一个问题出发，观察规划、求解与回环。<br />点击流程节点，看看代码真正做了什么。</p>
            </div>
            <span class="lab-reference" aria-hidden="true">HELLO AGENTS<br />PLAN-AND-SOLVE</span>
          </div>
          <ExperimentFlow flow={planFlow} />
        </section>
      )}

      {productProject && (
        <section class="product" aria-labelledby="product-title">
          <div class="section-heading">
            <div>
              <p class="eyebrow">04 / BUILT WITH CURIOSITY</p>
              <h2 id="product-title">从代码到界面</h2>
            </div>
            <a class="text-link" href={`${basePath}projects/`}>全部项目 <span aria-hidden="true">→</span></a>
          </div>
          <div class="grid product-grid">
            <a class="product-image" href={`${basePath}projects/${productProject.id}/`} tabindex="-1" aria-hidden="true">
              <Image src={workbench} alt="" width={1100} widths={[550, 1100]} sizes="(max-width: 1080px) 100vw, 55vw" loading="lazy" />
            </a>
            <div class="product-copy">
              <p class="eyebrow label-plain">LOCAL WEB WORKBENCH</p>
              <h3>{productProject.data.title}</h3>
              <p>{productProject.data.description}</p>
              <ul class="product-tags">
                {productProject.data.tags.slice(0, 4).map((tag) => <li>{tag}</li>)}
              </ul>
              <a class="text-link" href={`${basePath}projects/${productProject.id}/`}>查看项目档案 <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </section>
      )}

    </main>
    <Footer showStudioNote />
  </body>
</html>

<style>
  /* --- Masthead --------------------------------------------------------- */

  .masthead {
    padding-block: var(--space-l) var(--space-2xl);
  }
  .masthead-copy {
    grid-column: 1 / span 7;
  }
  .masthead h1 {
    margin: var(--space-m) 0 var(--space-m);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-5);
    line-height: 1.22;
    letter-spacing: -0.035em;
  }
  .masthead-lede {
    max-width: 34rem;
    color: var(--muted);
    font-size: var(--step-0);
    line-height: 1.9;
  }
  .masthead-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
    margin-top: var(--space-l);
  }

  .masthead-rail {
    grid-column: 9 / -1;
    align-self: end;
  }
  .stat-list {
    margin: 0;
    border-top: 1px solid var(--line-ink);
  }
  .stat-list > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: var(--space-2xs);
    border-bottom: 1px solid var(--line);
  }
  .stat-list dt {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.12em;
  }
  .stat-list dd {
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
    margin: 0;
  }
  .stat-value {
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: var(--step-2);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .stat-detail {
    color: var(--muted);
    font-size: var(--step--2);
  }

  .rail-latest {
    margin-top: var(--space-l);
  }
  .rail-latest a {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding-top: var(--space-2xs);
    border-top: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }
  .rail-date {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--step--2);
  }
  .rail-latest strong {
    font-size: var(--step-0);
    font-weight: 400;
    line-height: 1.5;
    transition: color var(--motion-fast);
  }
  .rail-reading {
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: var(--step--2);
  }
  .rail-latest a:hover strong {
    color: var(--accent-text);
  }

  /* --- Topic index ------------------------------------------------------ */

  .topic-index {
    padding-block: var(--space-xl);
    border-top: 1px solid var(--line-ink);
  }
  .index-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-m);
    margin-bottom: var(--space-s);
  }
  .index-head .eyebrow {
    margin: 0;
  }
  .index-hint {
    color: var(--muted);
    font-size: var(--step--2);
  }
  .topic-rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .topic-rows li + li {
    border-top: 1px solid var(--line);
  }
  .topic-rows a {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) minmax(0, 1.4fr) 3rem 2rem;
    align-items: baseline;
    gap: var(--space-s);
    padding-block: var(--space-s);
    color: var(--ink);
    text-decoration: none;
    transition: background-color var(--motion-fast), padding-left var(--motion-base);
  }
  .topic-index-num {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-variant-numeric: tabular-nums;
  }
  .topic-label {
    font-family: var(--font-display);
    font-size: var(--step-2);
    letter-spacing: -0.02em;
  }
  .topic-subtitle {
    color: var(--muted);
    font-size: var(--step--1);
  }
  .topic-count {
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .topic-arrow {
    color: var(--muted);
    text-align: right;
    transition: transform var(--motion-base), color var(--motion-fast);
  }
  .topic-rows a:is(:hover, :focus-visible) {
    background: var(--accent-soft);
    padding-left: var(--space-s);
  }
  .topic-rows a:is(:hover, :focus-visible) .topic-label {
    color: var(--accent-text);
  }
  .topic-rows a:is(:hover, :focus-visible) .topic-arrow {
    color: var(--accent-text);
    transform: translateX(4px);
  }

  /* --- Sections --------------------------------------------------------- */

  .feature,
  .writing,
  .lab,
  .product {
    padding-block: var(--space-2xl);
    border-top: 1px solid var(--line-ink);
  }

  /* --- Feature ---------------------------------------------------------- */

  .feature-image {
    grid-column: 1 / span 7;
    display: block;
    overflow: hidden;
    background: var(--plate);
    border: 1px solid var(--line);
    transition: border-color var(--motion-fast);
  }
  .feature-image :global(img) {
    width: 100%;
    transition: transform var(--motion-slow);
  }
  .feature-copy {
    grid-column: 8 / -1;
    align-self: center;
  }
  .feature-copy h3 {
    margin-bottom: var(--space-xs);
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: -0.028em;
  }
  .feature-copy h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  .feature-copy p {
    color: var(--muted);
    font-size: var(--step--1);
    line-height: 1.8;
  }
  .feature-image:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .feature:focus-within .feature-image {
    border-color: var(--accent);
  }
  .feature:focus-within .feature-image :global(img) {
    transform: scale(1.02);
  }
  @media (hover: hover) {
    .feature:hover .feature-image {
      border-color: var(--accent);
    }
    .feature:hover .feature-image :global(img) {
      transform: scale(1.02);
    }
    .feature-copy h3 a:hover {
      color: var(--accent-text);
    }
  }

  /* --- Writing grid ----------------------------------------------------- */

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-l);
  }

  /* --- Lab -------------------------------------------------------------- */

  .lab-intro {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: var(--space-l);
    margin-bottom: var(--space-m);
  }
  .lab-label {
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
  }
  .lab-intro p {
    margin: var(--space-2xs) 0 0;
    color: var(--muted);
    font-size: var(--step--1);
    line-height: 1.8;
  }
  .lab-reference {
    flex-shrink: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    line-height: 1.6;
    text-align: right;
  }

  /* --- Product ---------------------------------------------------------- */

  .product-image {
    grid-column: 1 / span 7;
    display: block;
    overflow: hidden;
    background: var(--plate);
    border: 1px solid var(--line);
    transition: border-color var(--motion-fast);
  }
  .product-image :global(img) {
    width: 100%;
    transition: transform var(--motion-slow);
  }
  .product-copy {
    grid-column: 8 / -1;
    align-self: center;
  }
  .product-copy h3 {
    margin-bottom: var(--space-xs);
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 400;
    letter-spacing: -0.028em;
  }
  .product-copy > p:not(.eyebrow) {
    color: var(--muted);
    font-size: var(--step--1);
    line-height: 1.8;
  }
  .product-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin: var(--space-s) 0;
    padding: 0;
    list-style: none;
  }
  .product-tags li {
    padding: 0.15rem 0.5rem;
    color: var(--muted);
    border: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--step--2);
  }
  .product-image:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .product:focus-within .product-image {
    border-color: var(--accent);
  }
  .product:focus-within .product-image :global(img) {
    transform: scale(1.02);
  }
  @media (hover: hover) {
    .product:hover .product-image {
      border-color: var(--accent);
    }
    .product:hover .product-image :global(img) {
      transform: scale(1.02);
    }
  }

  /* --- Breakpoints ------------------------------------------------------ */

  @media (max-width: 1080px) {
    .masthead-copy,
    .masthead-rail,
    .feature-image,
    .feature-copy,
    .product-image,
    .product-copy {
      grid-column: 1 / -1;
    }
    .masthead-rail {
      margin-top: var(--space-xl);
    }
    .feature-copy,
    .product-copy {
      margin-top: var(--space-l);
    }
  }

  @media (max-width: 720px) {
    .masthead {
      padding-block: var(--space-s) var(--space-xl);
    }
    .masthead-actions {
      margin-top: var(--space-m);
      gap: var(--space-s);
    }
    .topic-rows a {
      grid-template-columns: 2rem minmax(0, 1fr) 2rem;
      gap: var(--space-2xs) var(--space-s);
      padding-block: var(--space-s);
    }
    .topic-subtitle {
      grid-column: 2 / -1;
      font-size: var(--step--2);
    }
    .topic-count {
      grid-area: 1 / 3;
    }
    .topic-arrow {
      display: none;
    }
    .articles-grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
    .feature,
    .writing,
    .lab,
    .product {
      padding-block: var(--space-xl);
    }
    .lab-intro {
      flex-direction: column;
      gap: var(--space-s);
    }
    .lab-reference {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .topic-rows a,
    .topic-arrow,
    .feature-image :global(img),
    .product-image :global(img),
    .rail-latest strong {
      transition: none;
    }
    .topic-rows a:is(:hover, :focus-visible) .topic-arrow {
      transform: none;
    }
    .topic-rows a:is(:hover, :focus-visible) {
      padding-left: 0;
    }
    .feature:is(:hover, :focus-within) .feature-image :global(img),
    .product:is(:hover, :focus-within) .product-image :global(img) {
      transform: none;
    }
  }
</style>
