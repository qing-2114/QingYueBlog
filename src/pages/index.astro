---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ArticlePreview from '../components/ArticlePreview.astro';
import Icon from '../components/Icon.astro';
import ExperimentFlow from '../components/ExperimentFlow.astro';
import { planFlow } from '../data/experiment-flows';
import workbench from '../assets/grok-build-web/workbench.png';
import heroArt from '../assets/site/hero-desk.png';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { articleCover, basePath, byDate, readingMinutes, topics, topicHref } from '../utils/content';

const posts = (await getCollection('blog')).sort(byDate);
const projects = await getCollection('projects');
const latest = posts[0];
const latestCover = latest && articleCover(latest);
const agentProject = projects.find((project) => project.id === 'my-hello-agent');
const productProject = projects.find((project) => project.id === 'grok-build-web');

const pad = (value: number) => String(value).padStart(2, '0');
const topicCount = (category: string) => posts.filter((post) => post.data.category === category).length;

// Masthead counters: an icon and a number the reader can check.
const stats = [
  { icon: 'writing', value: pad(posts.length), detail: '文章' },
  { icon: 'flask', value: pad(projects.length), detail: '项目' },
  { icon: 'calendar', value: pad(topics.length), detail: '方向' },
] as const;
---

<!doctype html>
<html lang="zh-CN">
  <head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
  <body>
    <Header />
    <main class="home" id="main-content">

      <!-- Masthead: the headline holds seven columns, the illustration five.
           Asymmetry is the point — this is a masthead, not a centered hero. -->
      <section class="masthead" aria-labelledby="hero-title">
        <div class="grid">
          <div class="masthead-copy">
            <p class="eyebrow">QINGYUE&nbsp;/&nbsp;FIELD&nbsp;NOTES&nbsp;/&nbsp;{new Date().getFullYear()}</p>
            <h1 id="hero-title">让想法落地，<br />让探索留下痕迹。</h1>
            <p class="masthead-lede">清月 · AI / 机器人 / 代码</p>
            <div class="masthead-actions">
              <a class="button primary" href={`${basePath}blog/`}>读文章 <span aria-hidden="true">→</span></a>
              <a class="text-link" href={`${basePath}projects/`}>看实验 <span aria-hidden="true">→</span></a>
            </div>
            <dl class="stat-list" aria-label="站点概览">
              {stats.map((stat) => (
                <div>
                  <dt><Icon name={stat.icon} size={18} /><span class="sr-only">{stat.detail}</span></dt>
                  <dd><span class="stat-value">{stat.value}</span><span class="stat-detail" aria-hidden="true">{stat.detail}</span></dd>
                </div>
              ))}
            </dl>
          </div>

          <div class="masthead-art" aria-hidden="true">
            <Image class="line-art" src={heroArt} alt="" width={720} widths={[360, 720]} sizes="(max-width: 1080px) 80vw, 40vw" loading="eager" />
          </div>
        </div>
      </section>

      <!-- Topic index: a table of contents, numbered like a drawing set. -->
      <nav class="topic-index" aria-label="按主题阅读">
        <ol class="topic-tiles">
          {topics.map((topic) => (
            <li>
              <a href={topicHref(topic.category)} title={topic.subtitle}>
                <Icon name={topic.icon} size={36} class="topic-icon" />
                <span class="topic-label">{topic.label}</span>
                <span class="topic-count" aria-label={`${topicCount(topic.category)} 篇`}>{pad(topicCount(topic.category))}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      {latest && latestCover && (
        <section class="feature" aria-labelledby="feature-title">
          <div class="section-heading">
            <div>
              <p class="eyebrow">01 / LATEST</p>
              <h2 id="feature-title">最新</h2>
            </div>
            <a class="text-link" href={`${basePath}blog/`}>全部文章 <span aria-hidden="true">→</span></a>
          </div>
          <div class="grid feature-grid">
            <a class="feature-image" href={`${basePath}blog/${latest.id}/`} tabindex="-1" aria-hidden="true">
              <Image src={latestCover} alt="" width={1100} height={690} widths={[560, 1100]} sizes="(max-width: 1080px) 100vw, 58vw" loading="eager" />
            </a>
            <div class="feature-copy">
              <div class="article-meta">
                <span>{latest.data.category}</span>
                <FormattedDate date={latest.data.pubDate} />
                <span><Icon name="clock" size={14} /> {readingMinutes(latest.body)} min</span>
              </div>
              <h3><a href={`${basePath}blog/${latest.id}/`}>{latest.data.title}</a></h3>
            </div>
          </div>
        </section>
      )}

      <section class="writing" aria-labelledby="writing-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">02 / FIELD NOTES</p>
            <h2 id="writing-title">文章</h2>
          </div>
          <a class="text-link" href={`${basePath}blog/`}>全部文章 <span aria-hidden="true">→</span></a>
        </div>
        <div class="articles-grid">
          {posts.slice(1, 4).map((post, i) => <ArticlePreview post={post} index={pad(i + 2)} />)}
        </div>
      </section>

      {agentProject && (
        <section class="lab" aria-labelledby="lab-title">
          <div class="section-heading">
            <div>
              <p class="eyebrow">03 / LAB</p>
              <h2 id="lab-title">实验</h2>
            </div>
            <a class="text-link" href={`${basePath}projects/my-hello-agent/`}>进入实验室 <span aria-hidden="true">→</span></a>
          </div>
          <ExperimentFlow flow={planFlow} />
        </section>
      )}

      {productProject && (
        <section class="product" aria-labelledby="product-title">
          <div class="section-heading">
            <div>
              <p class="eyebrow">04 / BUILD</p>
              <h2 id="product-title">项目</h2>
            </div>
            <a class="text-link" href={`${basePath}projects/`}>全部项目 <span aria-hidden="true">→</span></a>
          </div>
          <div class="grid product-grid">
            <a class="product-image" href={`${basePath}projects/${productProject.id}/`} tabindex="-1" aria-hidden="true">
              <Image src={workbench} alt="" width={1100} widths={[550, 1100]} sizes="(max-width: 1080px) 100vw, 55vw" loading="lazy" />
            </a>
            <div class="product-copy">
              <p class="eyebrow label-plain">LOCAL WEB WORKBENCH</p>
              <h3>{productProject.data.title}</h3>
              <ul class="product-tags">
                {productProject.data.tags.slice(0, 4).map((tag) => <li>{tag}</li>)}
              </ul>
              <a class="text-link" href={`${basePath}projects/${productProject.id}/`}>查看项目档案 <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </section>
      )}

    </main>
    <Footer showStudioNote />
  </body>
</html>

<style>
  /* --- Masthead --------------------------------------------------------- */

  .masthead {
    padding-block: var(--space-l) var(--space-2xl);
  }
  .masthead-copy {
    grid-column: 1 / span 7;
  }
  .masthead h1 {
    margin: var(--space-m) 0 var(--space-m);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-5);
    line-height: 1.22;
    letter-spacing: -0.035em;
  }
  .masthead-lede {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
  }
  .masthead-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
    margin-top: var(--space-l);
  }

  .masthead-art {
    grid-column: 8 / -1;
    align-self: end;
  }
  .masthead-art :global(img) {
    max-width: 30rem;
    margin-left: auto;
  }

  .stat-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-l);
    margin: var(--space-xl) 0 0;
  }
  .stat-list > div {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }
  .stat-list dt {
    display: grid;
    place-items: center;
    color: var(--muted);
  }
  .stat-list dd {
    display: flex;
    align-items: baseline;
    gap: var(--space-3xs);
    margin: 0;
  }
  .stat-value {
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: var(--step-2);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .stat-detail {
    color: var(--muted);
    font-size: var(--step--2);
  }

  /* --- Topic tiles ------------------------------------------------------ */

  .topic-index {
    padding-block: var(--space-xl);
    border-top: 1px solid var(--line-ink);
  }
  .topic-tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--line);
  }
  .topic-tiles li {
    border-right: 1px solid var(--line);
  }
  .topic-tiles a {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-s);
    min-height: 44px;
    padding: var(--space-m);
    color: var(--ink);
    text-decoration: none;
    transition: background-color var(--motion-fast);
  }
  .topic-tiles :global(.topic-icon) {
    color: var(--ink);
    transition: color var(--motion-fast), transform var(--motion-base);
  }
  .topic-label {
    font-family: var(--font-display);
    font-size: var(--step-1);
    letter-spacing: -0.02em;
  }
  .topic-count {
    position: absolute;
    top: var(--space-m);
    right: var(--space-m);
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }
  .topic-tiles a:is(:hover, :focus-visible) {
    background: var(--accent-soft);
  }
  .topic-tiles a:is(:hover, :focus-visible) :global(.topic-icon) {
    color: var(--accent-text);
    transform: translateY(-2px);
  }

  /* --- Sections --------------------------------------------------------- */

  .feature,
  .writing,
  .lab,
  .product {
    padding-block: var(--space-2xl);
    border-top: 1px solid var(--line-ink);
  }

  /* --- Feature ---------------------------------------------------------- */

  .feature-image {
    grid-column: 1 / span 7;
    display: block;
    overflow: hidden;
    background: var(--plate);
    border: 1px solid var(--line);
    transition: border-color var(--motion-fast);
  }
  .feature-image :global(img) {
    width: 100%;
    transition: transform var(--motion-slow);
  }
  .feature-copy {
    grid-column: 8 / -1;
    align-self: center;
  }
  .feature-copy h3 {
    margin-bottom: var(--space-xs);
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: -0.028em;
  }
  .feature-copy h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  .feature-image:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .feature:focus-within .feature-image {
    border-color: var(--accent);
  }
  .feature:focus-within .feature-image :global(img) {
    transform: scale(1.02);
  }
  @media (hover: hover) {
    .feature:hover .feature-image {
      border-color: var(--accent);
    }
    .feature:hover .feature-image :global(img) {
      transform: scale(1.02);
    }
    .feature-copy h3 a:hover {
      color: var(--accent-text);
    }
  }

  /* --- Writing grid ----------------------------------------------------- */

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-l);
  }

  /* --- Product ---------------------------------------------------------- */

  .product-image {
    grid-column: 1 / span 7;
    display: block;
    overflow: hidden;
    background: var(--plate);
    border: 1px solid var(--line);
    transition: border-color var(--motion-fast);
  }
  .product-image :global(img) {
    width: 100%;
    transition: transform var(--motion-slow);
  }
  .product-copy {
    grid-column: 8 / -1;
    align-self: center;
  }
  .product-copy h3 {
    margin-bottom: var(--space-xs);
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 400;
    letter-spacing: -0.028em;
  }
  .product-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin: var(--space-s) 0;
    padding: 0;
    list-style: none;
  }
  .product-tags li {
    padding: 0.15rem 0.5rem;
    color: var(--muted);
    border: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--step--2);
  }
  .product-image:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .product:focus-within .product-image {
    border-color: var(--accent);
  }
  .product:focus-within .product-image :global(img) {
    transform: scale(1.02);
  }
  @media (hover: hover) {
    .product:hover .product-image {
      border-color: var(--accent);
    }
    .product:hover .product-image :global(img) {
      transform: scale(1.02);
    }
  }

  /* --- Breakpoints ------------------------------------------------------ */

  @media (max-width: 1080px) {
    .masthead-copy,
    .masthead-art,
    .feature-image,
    .feature-copy,
    .product-image,
    .product-copy {
      grid-column: 1 / -1;
    }
    .masthead-art :global(img) {
      max-width: 16rem;
      margin-inline: auto 0;
    }
    .feature-copy,
    .product-copy {
      margin-top: var(--space-l);
    }
  }

  @media (max-width: 720px) {
    .masthead {
      padding-block: var(--space-s) var(--space-xl);
    }
    .masthead-actions {
      margin-top: var(--space-m);
      gap: var(--space-s);
    }
    .topic-tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border-top: 1px solid var(--line);
    }
    .topic-tiles li {
      border-bottom: 1px solid var(--line);
    }
    .topic-tiles a {
      padding: var(--space-s);
    }
    .topic-count {
      top: var(--space-s);
      right: var(--space-s);
    }
    .stat-list {
      margin-top: var(--space-l);
      gap: var(--space-m);
    }
    .articles-grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
    .feature,
    .writing,
    .lab,
    .product {
      padding-block: var(--space-xl);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .topic-tiles a,
    .topic-tiles :global(.topic-icon),
    .feature-image :global(img),
    .product-image :global(img) {
      transition: none;
    }
    .topic-tiles a:is(:hover, :focus-visible) :global(.topic-icon) {
      transform: none;
    }
    .feature:is(:hover, :focus-within) .feature-image :global(img),
    .product:is(:hover, :focus-within) .product-image :global(img) {
      transform: none;
    }
  }
</style>
