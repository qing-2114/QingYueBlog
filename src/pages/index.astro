---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">PERSONAL JOURNAL</p>
				<h1 class="script-title">QingYue Blog</h1>
				<p class="intro calligraphy-intro">这里是我的数字小屋，记录技术探索、日常思考，以及那些值得慢慢写下来的瞬间。</p>
				<div class="actions"><a class="button primary" href={`${base}blog`}>阅读文章 <span>→</span></a><a class="button ghost" href={`${base}about`}>认识清月</a></div>
			</section>

			<section class="latest" aria-labelledby="latest-title">
				<div class="section-heading"><div><p class="eyebrow">FROM THE JOURNAL</p><h2 id="latest-title">最近写了什么</h2></div><a href={`${base}blog`}>查看全部 →</a></div>
				<div class="post-grid">
					{posts.map((post) => <a class="post-card" href={`${base}blog/${post.id}/`}><p class="date"><FormattedDate date={post.data.pubDate} /></p><h3>{post.data.title}</h3><p class="description">{post.data.description}</p><span class="read-more">继续阅读 →</span></a>)}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero { max-width: 760px; padding: 5rem 0 7rem; }
	.eyebrow { margin-bottom: 1rem; color: var(--accent); font-size: .72rem; font-weight: 700; letter-spacing: .16em; }
	.script-title { margin-left: -.08em; color: #18334d; filter: drop-shadow(0 8px 10px rgba(24,51,77,.12)); font-family: "Pinyon Script", "Great Vibes", "Segoe Script", "Lucida Handwriting", "Brush Script MT", cursive; font-size: clamp(4.4rem, 12vw, 8.4rem); font-weight: 400; letter-spacing: .015em; line-height: .95; }
	.intro { max-width: 580px; margin: 1.5rem 0 2rem; color: var(--muted); font-size: 1.14rem; }
	.calligraphy-intro { color: #30465a; font-family: "SimSun", "宋体", "STSong", "Songti SC", serif; font-size: clamp(1.12rem, 2.2vw, 1.28rem); font-weight: 400; letter-spacing: .04em; line-height: 1.9; -webkit-text-stroke: .1px currentColor; }
	.actions { display: flex; gap: .7rem; flex-wrap: wrap; }
	.button { padding: .65rem 1rem; border-radius: 9px; font-size: .9rem; text-decoration: none; transition: transform .2s, box-shadow .2s; }
	.button:hover { transform: translateY(-2px); }
	.primary { color: #fff; background: linear-gradient(135deg, #4b9cda, #287fc3); box-shadow: 0 8px 18px rgba(40,127,195,.25); }
	.ghost { color: var(--accent); border: 1px solid var(--line); background: rgba(255,255,255,.48); }
	.latest { padding-bottom: 2rem; }
	.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1.4rem; }
	.section-heading h2 { margin: 0; }
	.section-heading > a { font-size: .86rem; text-decoration: none; }
	.post-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
	.post-card { display: flex; min-height: 220px; flex-direction: column; padding: 1.25rem; color: inherit; background: rgba(255,255,255,.62); border: 1px solid var(--line); border-radius: 11px; box-shadow: 0 8px 24px rgba(38,111,170,.06); text-decoration: none; backdrop-filter: blur(14px); transition: transform .2s, box-shadow .2s; }
	.post-card:hover { transform: translateY(-4px); box-shadow: var(--box-shadow); }
	.post-card .date { color: var(--accent); font-size: .76rem; }
	.post-card h3 { margin-bottom: .6rem; font-size: 1.25rem; }
	.description { color: var(--muted); font-size: .9rem; line-height: 1.55; }
	.read-more { margin-top: auto; color: var(--accent); font-size: .82rem; }
	@media (max-width: 720px) { .hero { padding: 3rem 0 5rem; } .post-grid { grid-template-columns: 1fr; } .section-heading { align-items: start; flex-direction: column; } }
</style>
