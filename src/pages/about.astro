	.value-number { color: var(--accent); font-size: .72rem; font-weight: 700; letter-spacing: .12em; }
	.value-grid h3 { margin: 1.4rem 0 .35rem; font-size: 1.25rem; }
	.value-grid p { margin: 0; color: var(--muted); font-size: .86rem; }
	.closing-note { display: flex; justify-content: space-between; align-items: center; gap: 2rem; padding: 2.2rem 2.5rem; color: #fff; background: linear-gradient(110deg, #1b5d8f, #398dcc); border-radius: 16px; box-shadow: 0 18px 40px rgba(30,95,145,.2); }
	.closing-note .eyebrow { margin-bottom: .65rem; color: rgba(255,255,255,.68); }
	.closing-note h2 { margin: 0; color: #fff; font-family: "SimSun", "宋体", serif; font-size: clamp(1.7rem, 3vw, 2.35rem); font-weight: 400; letter-spacing: .08em; }
	.button.light { color: var(--accent-dark); background: #fff; box-shadow: 0 7px 16px rgba(13,56,88,.15); white-space: nowrap; }
	@media (max-width: 980px) { .about-page { padding-top: 2rem; } .about-hero { gap: 2.7rem; padding-bottom: 5rem; } .intro-grid { grid-template-columns: 1fr; gap: 2.7rem; } .profile-card { max-width: 620px; } .contribution-card { max-width: 100%; } .content-grid { grid-template-columns: 1fr; gap: 3rem; } .now-card { max-width: 560px; } }
	@media (max-width: 560px) { .about-hero { min-height: 0; } .contribution-header { align-items: flex-start; flex-direction: column; gap: .25rem; } .contribution-card { overflow-x: auto; } .contribution-body { min-width: 420px; } .graph-wrap { overflow-x: auto; } .month-labels, .contribution-grid { min-width: 560px; } .value-grid { grid-template-columns: 1fr; } .section-heading, .closing-note { align-items: start; flex-direction: column; } .heading-aside { text-align: left; } .closing-note { padding: 1.7rem 1.4rem; } .closing-note .button { margin-top: .5rem; } }
</style>
