	.profile-divider { margin: 1.45rem 0 1.05rem; border-top: 1px solid rgba(138,180,224,.24); }
	.profile-row { display: flex; justify-content: space-between; gap: 1rem; color: var(--muted); font-size: .78rem; }
	.profile-row strong { color: var(--ink); font-weight: 400; text-align: right; }
	.profile-direction { display: block; }
	.profile-direction > span { display: block; margin-bottom: .65rem; color: var(--accent); font-size: .68rem; font-weight: 700; letter-spacing: .13em; }
	.direction-tags { display: flex; flex-wrap: wrap; gap: .45rem; }
	.direction-tags span { padding: .3rem .65rem; color: var(--accent-dark); background: rgba(91,163,224,.1); border: 1px solid rgba(91,163,224,.22); border-radius: 8px; font-size: .76rem; font-weight: 400; line-height: 1.7; }
	.profile-github { display: flex; justify-content: space-between; gap: 1rem; margin-top: 1.15rem; padding-top: .95rem; color: var(--accent); border-top: 1px solid rgba(138,180,224,.24); font-size: .8rem; text-decoration: none; }
	.profile-github:hover { color: var(--accent-dark); }
	.contribution-card { width: 100%; padding: 1.35rem 1.4rem 1.3rem; color: var(--muted); background: rgba(255,255,255,.58); border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--box-shadow); backdrop-filter: blur(15px); font-size: .76rem; }
	.contribution-header { display: flex; justify-content: space-between; align-items: center; gap: .7rem; margin-bottom: .65rem; }
	.contribution-header strong { color: var(--ink); font-size: .92rem; font-weight: 700; white-space: nowrap; }
	.contribution-header span { white-space: nowrap; }
	.contribution-header b { margin-left: .2rem; font-size: .65rem; }
	.contribution-body { display: flex; align-items: stretch; gap: .65rem; }
	.graph-wrap { min-width: 0; flex: 1; overflow: hidden; }
	.year-panel { display: none; }
	.year-panel.active { display: block; }
	.month-labels { display: grid; grid-template-columns: repeat(12, 1fr); height: 1.45rem; padding-left: 2.05rem; color: var(--muted); }
	.month-labels span { text-align: left; }
	.graph-row { display: flex; gap: .35rem; }
	.day-labels { display: grid; grid-template-rows: repeat(7, 1fr); width: 1.7rem; color: var(--muted); font-size: .7rem; line-height: 1; text-align: right; }
	.day-labels span { align-self: center; }
	.contribution-grid { display: grid; grid-template-columns: repeat(53, minmax(0, 1fr)); gap: 3px; width: 100%; }
	.week { display: grid; grid-template-rows: repeat(7, minmax(0, 1fr)); gap: 3px; }
	.contribution-grid span, .legend i { display: block; aspect-ratio: 1; min-width: 0; border: 1px solid rgba(40,127,195,.12); border-radius: 2px; }
	.contribution-grid span.outside { visibility: hidden; border-color: transparent; background: transparent; }
	.level-0 { background: #fff; }
	.level-2 { background: #a5d6f3; }
	.level-3 { background: #5eaee0; }
	.level-4 { background: #2478b8; }
	.graph-footer { display: flex; justify-content: flex-end; align-items: center; gap: .5rem; margin-top: .65rem; }
	.legend { display: inline-flex; align-items: center; gap: 3px; white-space: nowrap; }
	.legend i { width: 11px; }
	.year-list { display: flex; flex-direction: column; gap: .35rem; min-width: 3.8rem; color: var(--muted); text-align: center; }
	.year-list button { padding: .64rem .35rem; color: var(--muted); background: transparent; border: 0; border-radius: 8px; font: inherit; cursor: pointer; transition: color .2s, background .2s, transform .2s; }
	.year-list button:hover { color: var(--accent); background: rgba(91,163,224,.1); }
	.year-list button.active { color: #fff; background: var(--accent); font-weight: 700; box-shadow: 0 7px 16px rgba(40,127,195,.2); }
	.year-list span { padding: .55rem .2rem; }
	.pulse { display: inline-block; width: .42rem; height: .42rem; background: #55c48a; border-radius: 50%; box-shadow: 0 0 0 4px rgba(85,196,138,.13); }
	.content-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(310px, .72fr); gap: clamp(3rem, 10vw, 9rem); align-items: start; padding: 5.4rem 0; border-top: 1px solid var(--line); }
	.section-label { display: flex; gap: 1.1rem; align-items: center; margin-bottom: 1.3rem; color: var(--muted); font-size: .7rem; letter-spacing: .16em; text-transform: uppercase; }
	.section-label span:first-child { color: var(--accent); font-weight: 700; }
	.story-column h2 { margin-bottom: 1.4rem; font-size: clamp(2rem, 4vw, 3.1rem); letter-spacing: -.04em; }
	.story-column h2 em { color: var(--accent); font-style: normal; }
	.story-column p { max-width: 570px; color: var(--muted); font-size: .98rem; }
	.now-card { padding: 1.5rem 1.6rem 1.3rem; background: rgba(255,255,255,.63); border: 1px solid var(--line); border-radius: 14px; box-shadow: 0 14px 32px rgba(38,111,170,.09); backdrop-filter: blur(15px); }
	.now-top { display: flex; align-items: center; gap: .7rem; margin-bottom: 1.8rem; color: var(--accent); font-size: .68rem; font-weight: 700; letter-spacing: .2em; }
	.now-card h3 { margin-bottom: 1.2rem; font-size: 1.5rem; }
	.now-card ul { margin: 0; padding: 0; list-style: none; }
	.now-card li { display: flex; gap: .9rem; padding: .8rem 0; border-top: 1px solid rgba(138,180,224,.2); }
	.now-card li > span { color: var(--accent); font-size: .7rem; font-weight: 700; }
	.now-card strong, .now-card small { display: block; }
	.now-card strong { font-size: .93rem; }
	.now-card small { margin-top: .16rem; color: var(--muted); font-size: .77rem; line-height: 1.4; }
	.values { padding: 5.5rem 0 6.5rem; border-top: 1px solid var(--line); }
	.section-heading { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin-bottom: 2.2rem; }
	.section-heading h2 { margin: 0; font-size: clamp(2rem, 4vw, 2.8rem); }
	.heading-aside { margin: 0; color: var(--muted); font-size: .9rem; line-height: 1.6; text-align: right; }
