---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { execFileSync } from 'node:child_process';

const today = new Date();
today.setHours(0, 0, 0, 0);
const dateKey = (date: Date) =>
    `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
const commitDates = new Map<string, number>();
let historyAvailable = true;
try {
    const log = execFileSync(
        'git',
        ['log', '--since=3 years ago', '--format=%ad', '--date=short', '--', 'src'],
        { encoding: 'utf8' },
    );
    for (const date of log.split(/\r?\n/).filter(Boolean)) {
        commitDates.set(date, (commitDates.get(date) ?? 0) + 1);
    }
} catch {
    historyAvailable = false;
}
const monthFormatter = new Intl.DateTimeFormat('en-US', { month: 'short' });
const years = [today.getFullYear(), today.getFullYear() - 1, today.getFullYear() - 2];
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const buildYearGraph = (year: number) => {
    const firstDay = new Date(year, 0, 1);
    const offset = firstDay.getDay();
    firstDay.setDate(firstDay.getDate() - offset);
    const daysInYear = new Date(year, 1, 29).getMonth() === 1 ? 366 : 365;
    const weeks = Math.ceil((offset + daysInYear) / 7);
    const levels = Array.from({ length: weeks }, (_, week) =>
        Array.from({ length: 7 }, (_, day) => {
            const date = new Date(firstDay);
            date.setDate(firstDay.getDate() + week * 7 + day);
            const key = dateKey(date);
            const inYear = date.getFullYear() === year;
            const count = inYear ? commitDates.get(key) ?? 0 : 0;
            return {
                level: count === 0 ? 0 : count === 1 ? 2 : count === 2 ? 3 : 4,
                count,
                inYear,
                date: key,
            };
        }),
    );
    const activeDays = [...commitDates.entries()]
        .filter(([date]) => date.startsWith(`${year}-`))
        .sort(([a], [b]) => b.localeCompare(a));
    const count = activeDays.reduce((sum, [, value]) => sum + value, 0);
    const months = Array.from({ length: 12 }, (_, index) => ({
        label: monthFormatter.format(new Date(year, index, 1)),
        column: Math.floor((new Date(year, index, 1).getTime() - firstDay.getTime()) / 604800000) + 1,
    }));
    return { year, weeks, levels, count, months, activeDays };
};
const yearGraphs = years.map(buildYearGraph);
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <BaseHead title="关于清月" description="清月，机器人专业学生。记录 AI Agent、机器人与嵌入式系统的学习实践。" />
    </head>
    <body>
        <Header />
        <main id="main-content" class="about-page">
            <header class="about-intro">
                <div class="intro-copy" data-reveal>
                    <p class="eyebrow">ABOUT / 认识清月</p>
                    <h1>保持好奇，<br />把问题做深一点。</h1>
                    <p class="lead">你好，我是清月。<br />一名正在学习与实践的机器人专业学生。</p>
                    <p class="intro-note">我关注 AI Agent、机器人与嵌入式系统。在这里记录代码、实验，也写下技术之外的观察。</p>
                    <a class="text-link" href="https://github.com/qing-2114" target="_blank" rel="noreferrer">
                        GitHub · qing-2114 <span aria-hidden="true">↗</span>
                    </a>
                </div>
                <aside class="profile-note" data-reveal aria-label="学习方向">
                    <p class="eyebrow">FIELD NOTES</p>
                    <span class="profile-monogram" aria-hidden="true">清月</span>
                    <p class="profile-caption">学习 · 实验 · 记录</p>
                    <dl>
                        <div><dt>学习方向</dt><dd>机器人</dd></div>
                        <div><dt>正在关注</dt><dd>AI Agent / ROS / STM32</dd></div>
                        <div><dt>记录方式</dt><dd>文章与交互实验</dd></div>
                    </dl>
                </aside>
            </header>

            <section class="about-story" aria-labelledby="story-title">
                <div class="section-label"><span>01</span> WHY I WRITE</div>
                <div class="story-copy">
                    <h2 id="story-title">让每一次实践，<br />留下可以回看的过程。</h2>
                    <p>写作对我来说，是一次次把问题摊开、重新理解的过程。技术文章记录方法与经验，项目档案保留目标、代码边界与阶段变化。</p>
                    <p>我也会写阅读笔记和生活观察。没有想清楚的问题可以继续想，走过的弯路也值得认真记录。</p>
                    <div class="story-links">
                        <a class="text-link" href={`${base}blog/`}>阅读文章 <span aria-hidden="true">→</span></a>
                        <a class="text-link" href={`${base}projects/`}>探索实验 <span aria-hidden="true">→</span></a>
                    </div>
                </div>
            </section>

            <section class="activity-section" aria-labelledby="activity-title">
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">02 / BUILDING IN PUBLIC</p>
                        <h2 id="activity-title">持续记录的痕迹</h2>
                    </div>
                    <p>这份博客，也在一次次提交中生长。</p>
                </div>
                <div class="contribution-card">
                    <div class="contribution-header">
                        <strong id="contribution-total" aria-live="polite" aria-atomic="true">{yearGraphs[0].year} 年 · {yearGraphs[0].count} 次源码提交</strong>
                        <div class="year-list" role="group" aria-label="选择提交记录年份">
                            {yearGraphs.map((graph, index) => (
                                <button
                                    type="button"
                                    class:list={[{ active: index === 0 }]}
                                    data-year-tab={graph.year}
                                    data-count={graph.count}
                                    aria-controls={`year-${graph.year}`}
                                    aria-pressed={index === 0}
                                >
                                    {graph.year}
                                </button>
                            ))}
                        </div>
                    </div>
                    <div class="graph-scroll" tabindex="0" role="region" aria-label="每日提交热力图，可横向滚动">
                        {yearGraphs.map((graph, index) => (
                            <div
                                id={`year-${graph.year}`}
                                class="year-panel"
                                data-year={graph.year}
                                hidden={index !== 0}
                                style={`--weeks: ${graph.weeks}`}
                            >
                                <div class="month-labels" aria-hidden="true">
                                    {graph.months.map((month) => <span style={`grid-column: ${month.column} / span 3`}>{month.label}</span>)}
                                </div>
                                <div class="graph-row">
                                    <div class="day-labels" aria-hidden="true">
                                        <span></span><span>Mon</span><span></span><span>Wed</span><span></span><span>Fri</span><span></span>
                                    </div>
                                    <div class="contribution-grid" role="img" aria-label={`${graph.year} 年源码提交热力图，共 ${graph.count} 次提交，${graph.activeDays.length} 个活跃日。下方可查看每日记录。`}>
                                        {graph.levels.map((week) => (
                                            <div class="week">
                                                {week.map((cell) => (
                                                    <span aria-hidden="true" class:list={[`level-${cell.level}`, { outside: !cell.inYear }]} title={cell.inYear ? `${cell.date}：${cell.count} 次源码提交` : undefined}></span>
                                                ))}
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                    <div class="graph-footer">
                        <span class="graph-hint">窄屏可在图内横向滚动</span>
                        <span class="legend" aria-label="颜色由浅到深，表示 0 次、1 次、2 次和 3 次以上提交">少 <i class="level-0" aria-hidden="true"></i><i class="level-2" aria-hidden="true"></i><i class="level-3" aria-hidden="true"></i><i class="level-4" aria-hidden="true"></i> 多</span>
                    </div>
                    {yearGraphs.map((graph, index) => (
                        <details class="daily-records" data-record-year={graph.year} hidden={index !== 0}>
                            <summary>查看 {graph.year} 年的每日提交记录（{graph.activeDays.length} 个活跃日）</summary>
                            {graph.activeDays.length > 0 ? (
                                <ul>{graph.activeDays.map(([date, count]) => <li><time datetime={date}>{date}</time><span>{count} 次提交</span></li>)}</ul>
                            ) : <p>这一年没有可用的源码提交记录。</p>}
                        </details>
                    ))}
                </div>
                <p class="activity-note">统计本仓库 <code>src/</code> 的 Git 提交历史；按提交日期计数，构建时更新。{!historyAvailable && '本次构建未能读取 Git 历史，图表暂为空。'}</p>
            </section>

            <section class="values" aria-labelledby="values-title">
                <p class="eyebrow">03 / SMALL RULES</p>
                <h2 id="values-title">写给未来的自己</h2>
                <div class="value-grid">
                    <article><span class="value-number">01</span><h3>保持好奇</h3><p>先问为什么，再决定怎么做。</p></article>
                    <article><span class="value-number">02</span><h3>诚实记录</h3><p>承认不知道，也记录走过的弯路。</p></article>
                    <article><span class="value-number">03</span><h3>慢慢变好</h3><p>让每一次小小的迭代都算数。</p></article>
                </div>
            </section>
            <div class="closing-note">
                <p>路虽远，行则将至。</p>
                <a class="text-link" href={`${base}blog/`}>从一篇文章开始 <span aria-hidden="true">↗</span></a>
            </div>
        </main>
        <Footer />
    </body>
</html>

<script>
    const tabs = document.querySelectorAll<HTMLButtonElement>('[data-year-tab]');
    const panels = document.querySelectorAll<HTMLElement>('.year-panel');
    const records = document.querySelectorAll<HTMLDetailsElement>('[data-record-year]');
    const total = document.querySelector<HTMLElement>('#contribution-total');

    tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
            const year = tab.dataset.yearTab;
            tabs.forEach((item) => {
                const active = item === tab;
                item.classList.toggle('active', active);
                item.setAttribute('aria-pressed', String(active));
            });
            panels.forEach((panel) => {
                panel.hidden = panel.dataset.year !== year;
            });
            records.forEach((record) => {
                record.hidden = record.dataset.recordYear !== year;
            });
            if (total && year) {
                total.textContent = `${year} 年 · ${Number(tab.dataset.count ?? 0)} 次源码提交`;
            }
        });
    });
</script>

<style>
