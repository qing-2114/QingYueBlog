---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { execFileSync } from 'node:child_process';

const today = new Date();
today.setHours(0, 0, 0, 0);
const dateKey = (date: Date) => `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
const commitDates = new Map<string, number>();
try {
	const log = execFileSync('git', ['log', '--since=3 years ago', '--format=%ad', '--date=short', '--', 'src'], { encoding: 'utf8' });
	for (const date of log.split(/\r?\n/).filter(Boolean)) commitDates.set(date, (commitDates.get(date) ?? 0) + 1);
} catch {
	// The chart remains empty on hosts that build from a source archive without .git history.
}
const monthFormatter = new Intl.DateTimeFormat('en-US', { month: 'short' });
const years = [today.getFullYear(), today.getFullYear() - 1, today.getFullYear() - 2];
const base = import.meta.env.BASE_URL;
const buildYearGraph = (year: number) => {
	const firstDay = new Date(year, 0, 1);
	firstDay.setDate(firstDay.getDate() - firstDay.getDay());
	const levels = Array.from({ length: 53 }, (_, week) => Array.from({ length: 7 }, (_, day) => {
		const date = new Date(firstDay);
		date.setDate(firstDay.getDate() + week * 7 + day);
		if (date.getFullYear() !== year) return { level: 0, inYear: false, date: dateKey(date) };
		const count = commitDates.get(dateKey(date)) ?? 0;
		return { level: count === 0 ? 0 : count === 1 ? 2 : count === 2 ? 3 : 4, inYear: true, date: dateKey(date) };
	}));
	const count = [...commitDates.entries()].filter(([date]) => date.startsWith(`${year}-`)).reduce((sum, [, value]) => sum + value, 0);
	const months = Array.from({ length: 12 }, (_, index) => monthFormatter.format(new Date(year, index, 1)));
	return { year, levels, count, months };
};
const yearGraphs = years.map(buildYearGraph);
---

<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title="关于清月" description="认识清月，以及这个博客的由来。" /></head>
	<body>
		<Header />
		<main class="about-page">
			<section class="about-hero" aria-labelledby="about-title">
			<div class="intro-grid">
				<div class="hero-copy">
					<p class="eyebrow">A LITTLE INTRODUCTION</p>
					<h1 id="about-title"><span>清月</span></h1>
					<p class="lead">一个喜欢把复杂的事想清楚，再用自己的方式写下来的人。</p>
					<p class="hero-note">这里没有标准答案，只有正在发生的思考。欢迎你在字里行间，认识一个持续学习、持续创造的我。</p>
					<div class="hero-actions"><a class="button primary" href={`${base}blog`}>逛逛文章 <span aria-hidden="true">→</span></a></div>
				</div>
				<aside class="profile-card" aria-label="清月的个人标签和更新方向">
					<div class="profile-top"><span class="pulse"></span><span>PROFILE · 2026</span></div>
					<h2>正在关注的事</h2>
					<div class="tag-list"><span>技术探索</span><span>持续阅读</span><span>生活观察</span></div>
					<div class="profile-divider"></div>
					<div class="profile-row profile-direction"><span>更新方向</span><strong class="direction-tags"><span>AI Agent</span><span>ROS</span><span>STM32</span><span>机器人</span></strong></div>
					<a class="profile-github" href="https://github.com/qing-2114" target="_blank" rel="noreferrer"><span>GitHub</span><span aria-hidden="true">qing-2114 ↗</span></a>
				</aside>
			</div>
				<div class="contribution-card" aria-label="博客提交贡献记录">
					<div class="contribution-header"><strong id="contribution-total">{yearGraphs[0].count} {yearGraphs[0].count === 1 ? 'contribution' : 'contributions'} in {yearGraphs[0].year}</strong></div>
					<div class="contribution-body">
						<div class="graph-wrap">
							{yearGraphs.map((graph, index) => <div class:list={["year-panel", { active: index === 0 }]} data-year={graph.year} data-count={graph.count}>
								<div class="month-labels">{graph.months.map((month) => <span>{month}</span>)}</div>
								<div class="graph-row"><div class="day-labels" aria-hidden="true"><span></span><span>Mon</span><span></span><span>Wed</span><span></span><span>Fri</span><span></span></div><div class="contribution-grid" role="img" aria-label={`${graph.year} 年每天的博客提交热力图`}>{graph.levels.map((week) => <div class="week">{week.map((cell) => <span class:list={[`level-${cell.level}`, { outside: !cell.inYear }]} title={cell.inYear ? `${cell.date}: ${cell.level} contributions` : undefined}></span>)}</div>)}</div></div>
							</div>)}
							<div class="graph-footer"><span class="legend">Less <i class="level-0"></i><i class="level-2"></i><i class="level-3"></i><i class="level-4"></i> More</span></div>
						</div>
						<div class="year-list" aria-label="年份">{years.map((year, index) => <button class:list={[{ active: index === 0 }]} type="button" data-year-tab={year} data-count={yearGraphs[index].count} aria-pressed={index === 0}>{year}</button>)}</div>
					</div>
				</div>
			</section>

			<section class="content-grid" aria-label="关于清月">
				<div class="story-column">
					<div class="section-label"><span>01</span><span>我在记录什么</span></div>
					<h2>把日子过成一场<br /><em>长期实验</em></h2>
					<p>我会在这里记录技术实践、阅读笔记、关于生活的观察，以及一些还没有标准答案的问题。写作对我来说不是总结，而是一次次把问题摊开、重新理解的过程。</p>
					<p>如果某篇文章恰好帮你少走了一点弯路，或者让你对一个熟悉的事物多了一个角度，那这次记录就有了意义。</p>
				</div>
				<aside class="now-card"><div class="now-top"><span class="pulse"></span><span>NOW</span></div><h3>此刻，正在路上</h3><ul><li><span>01</span><div><strong>技术探索</strong><small>把好奇心变成可以运行的东西</small></div></li><li><span>02</span><div><strong>持续阅读</strong><small>收集值得反复回看的想法</small></div></li><li><span>03</span><div><strong>认真生活</strong><small>为平凡的瞬间保留一点注意力</small></div></li></ul></aside>
			</section>

			<section class="values" aria-labelledby="values-title">
				<div class="section-heading"><div><p class="eyebrow">MY SMALL RULES</p><h2 id="values-title">写给未来的自己</h2></div><p class="heading-aside">慢一点，深一点，<br />把重要的事做好。</p></div>
				<div class="value-grid"><article><span class="value-number">01</span><h3>保持好奇</h3><p>先问为什么，再决定怎么做。</p></article><article><span class="value-number">02</span><h3>诚实记录</h3><p>承认不知道，也记录走过的弯路。</p></article><article><span class="value-number">03</span><h3>慢慢变好</h3><p>让每一次小小的迭代都算数。</p></article></div>
			</section>

			<section class="closing-note"><div><p class="eyebrow">THANKS FOR STOPPING BY</p><h2>路虽远，行则将至。</h2></div><a class="button light" href={`${base}blog`}>从一篇文章开始 <span aria-hidden="true">↗</span></a></section>
		</main>
		<Footer />
	</body>
</html>

<script>
	const tabs = document.querySelectorAll<HTMLButtonElement>('[data-year-tab]');
	const panels = document.querySelectorAll<HTMLElement>('.year-panel');
	const total = document.querySelector<HTMLElement>('#contribution-total');
	tabs.forEach((tab) => tab.addEventListener('click', () => {
		const year = tab.dataset.yearTab;
		tabs.forEach((item) => {
			const active = item === tab;
			item.classList.toggle('active', active);
			item.setAttribute('aria-pressed', String(active));
		});
		panels.forEach((panel) => panel.classList.toggle('active', panel.dataset.year === year));
		if (total && year) {
			const count = Number(tab.dataset.count ?? 0);
			total.textContent = `${count} ${count === 1 ? 'contribution' : 'contributions'} in ${year}`;
		}
	}));
</script>

<style>
	.about-page { padding-top: 3.6rem; }
	.about-hero { display: flex; flex-direction: column; align-items: stretch; gap: clamp(3rem, 5vw, 4.5rem); min-height: 510px; padding: 2rem 0 6.5rem; }
	.intro-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(320px, .85fr); gap: clamp(2rem, 7vw, 7rem); align-items: center; }
	.hero-copy { max-width: 700px; padding: 2.2rem 2.4rem 2.3rem; background: rgba(255,255,255,.42); border: 1px solid var(--line); border-radius: 14px; box-shadow: 0 14px 34px rgba(38,111,170,.07); backdrop-filter: blur(12px); }
	.eyebrow { margin: 0 0 1.1rem; color: var(--accent); font-size: .7rem; font-weight: 700; letter-spacing: .2em; }
	.hero-copy h1 { max-width: 620px; margin-bottom: 1.5rem; }
	.hero-copy h1 span { color: var(--accent); white-space: nowrap; }
	.lead { max-width: 510px; margin-bottom: .8rem; color: var(--ink); font-size: clamp(1.15rem, 2.5vw, 1.45rem); line-height: 1.55; }
	.hero-note { max-width: 500px; margin-bottom: 2rem; color: var(--muted); font-size: .96rem; }
	.hero-actions { display: flex; align-items: center; gap: 1.3rem; flex-wrap: wrap; }
	.button { display: inline-flex; align-items: center; gap: .65rem; padding: .7rem 1.1rem; border-radius: 9px; font-size: .88rem; text-decoration: none; transition: transform .2s, box-shadow .2s; }
	.button:hover { transform: translateY(-2px); }
	.button.primary { color: #fff; background: linear-gradient(135deg, #4b9cda, #287fc3); box-shadow: 0 10px 22px rgba(40,127,195,.22); }
	.text-link { color: var(--muted); font-size: .88rem; text-decoration: none; }
	.text-link:hover { color: var(--accent); }
	.text-link span { margin-left: .2rem; color: var(--accent); }
	.profile-card { position: relative; overflow: hidden; padding: 1.8rem 1.85rem 1.45rem; background: linear-gradient(145deg, rgba(255,255,255,.68), rgba(224,241,253,.5)); border: 1px solid rgba(138,180,224,.3); border-radius: 14px; box-shadow: 0 18px 40px rgba(38,111,170,.11); backdrop-filter: blur(16px); }
	.profile-card::before { position: absolute; top: 0; right: 12%; left: 12%; height: 2px; background: linear-gradient(90deg, transparent, rgba(75,156,218,.55), transparent); content: ''; }
	.profile-top { display: flex; align-items: center; gap: .65rem; margin-bottom: 1.45rem; color: var(--accent); font-size: .68rem; font-weight: 700; letter-spacing: .18em; }
	.profile-card h2 { margin-bottom: 1.15rem; font-size: 1.55rem; letter-spacing: -.02em; }
