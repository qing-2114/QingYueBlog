---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import journeyArt from '../assets/site/about-journey.png';
import { execFileSync } from 'node:child_process';

const today = new Date();
today.setHours(0, 0, 0, 0);
const dateKey = (date: Date) =>
    `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
const commitDates = new Map<string, number>();
let historyAvailable = true;
try {
    const log = execFileSync(
        'git',
        ['log', '--since=3 years ago', '--format=%ad', '--date=short', '--', 'src'],
        { encoding: 'utf8' },
    );
    for (const date of log.split(/\r?\n/).filter(Boolean)) {
        commitDates.set(date, (commitDates.get(date) ?? 0) + 1);
    }
} catch {
    historyAvailable = false;
}
const monthFormatter = new Intl.DateTimeFormat('en-US', { month: 'short' });
const years = [today.getFullYear(), today.getFullYear() - 1, today.getFullYear() - 2];
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const buildYearGraph = (year: number) => {
    const firstDay = new Date(year, 0, 1);
    const offset = firstDay.getDay();
    firstDay.setDate(firstDay.getDate() - offset);
    const daysInYear = new Date(year, 1, 29).getMonth() === 1 ? 366 : 365;
    const weeks = Math.ceil((offset + daysInYear) / 7);
    // Five steps, 0 through 4. The scale used to skip a step (0/2/3/4); it now
    // maps one commit per level and clamps at four or more.
    const levels = Array.from({ length: weeks }, (_, week) =>
        Array.from({ length: 7 }, (_, day) => {
            const date = new Date(firstDay);
            date.setDate(firstDay.getDate() + week * 7 + day);
            const key = dateKey(date);
            const inYear = date.getFullYear() === year;
            const count = inYear ? commitDates.get(key) ?? 0 : 0;
            return {
                level: count === 0 ? 0 : count === 1 ? 1 : count === 2 ? 2 : count <= 4 ? 3 : 4,
                count,
                inYear,
                date: key,
            };
        }),
    );
    const activeDays = [...commitDates.entries()]
        .filter(([date]) => date.startsWith(`${year}-`))
        .sort(([a], [b]) => b.localeCompare(a));
    const count = activeDays.reduce((sum, [, value]) => sum + value, 0);
    const months = Array.from({ length: 12 }, (_, index) => ({
        label: monthFormatter.format(new Date(year, index, 1)),
        column: Math.floor((new Date(year, index, 1).getTime() - firstDay.getTime()) / 604800000) + 1,
    }));
    return { year, weeks, levels, count, months, activeDays };
};
const yearGraphs = years.map(buildYearGraph);
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <BaseHead title="关于清月" description="清月，机器人专业学生。记录 AI Agent、机器人与嵌入式系统的学习实践。" />
    </head>
    <body>
        <Header />
        <main id="main-content" class="about-page">

            <header class="about-intro">
                <div class="grid intro-grid">
                    <div class="intro-copy">
                        <p class="eyebrow">ABOUT&nbsp;/&nbsp;认识清月</p>
                        <h1>保持好奇，<br />把问题做深一点。</h1>
                        <p class="lead">你好，我是清月 · 机器人专业学生</p>
                        <a class="text-link" href="https://github.com/qing-2114" target="_blank" rel="noreferrer">
                            GitHub · qing-2114 <span aria-hidden="true">↗</span>
                        </a>
                    </div>
                    <aside class="profile-note" aria-label="学习方向">
                        <span class="profile-monogram" aria-hidden="true">清月</span>
                        <dl>
                            <div><dt><Icon name="robot" size={18} /><span class="sr-only">学习方向</span></dt><dd>机器人</dd></div>
                            <div><dt><Icon name="agent" size={18} /><span class="sr-only">正在关注</span></dt><dd>AI Agent / ROS / STM32</dd></div>
                            <div><dt><Icon name="writing" size={18} /><span class="sr-only">记录方式</span></dt><dd>文章与交互实验</dd></div>
                        </dl>
                    </aside>
                </div>
            </header>

            <section class="about-story" aria-labelledby="story-title">
                <p class="eyebrow section-label"><span class="index">01</span> WHY I WRITE</p>
                <div class="story-copy">
                    <h2 id="story-title">让每一次实践，<br />留下可以回看的过程。</h2>
                    <figure class="journey">
                        <Image class="line-art" src={journeyArt} alt="" width={1100} widths={[560, 1100]} sizes="(max-width: 1080px) 100vw, 60vw" loading="lazy" />
                        <figcaption>
                            <span><Icon name="search" size={16} />好奇</span>
                            <span><Icon name="robot" size={16} />实验</span>
                            <span><Icon name="pen" size={16} />记录</span>
                        </figcaption>
                    </figure>
                    <div class="story-links">
                        <a class="text-link" href={`${base}blog/`}>阅读文章 <span aria-hidden="true">→</span></a>
                        <a class="text-link" href={`${base}projects/`}>探索实验 <span aria-hidden="true">→</span></a>
                    </div>
                </div>
            </section>

            <section class="activity-section" aria-labelledby="activity-title">
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">02 / BUILDING IN PUBLIC</p>
                        <h2 id="activity-title">持续记录的痕迹</h2>
                    </div>
                </div>
                <div class="contribution-card">
                    <div class="contribution-header">
                        <strong id="contribution-total" aria-live="polite" aria-atomic="true">{yearGraphs[0].year} 年 · {yearGraphs[0].count} 次源码提交</strong>
                        <div class="year-list" role="group" aria-label="选择提交记录年份">
                            {yearGraphs.map((graph, index) => (
                                <button
                                    type="button"
                                    class:list={[{ active: index === 0 }]}
                                    data-year-tab={graph.year}
                                    data-count={graph.count}
                                    aria-controls={`year-${graph.year}`}
                                    aria-pressed={index === 0}
                                >
                                    {graph.year}
                                </button>
                            ))}
                        </div>
                    </div>
                    <div class="graph-scroll" tabindex="0" role="region" aria-label="每日提交热力图，可横向滚动">
                        {yearGraphs.map((graph, index) => (
                            <div
                                id={`year-${graph.year}`}
                                class="year-panel"
                                data-year={graph.year}
                                hidden={index !== 0}
                                style={`--weeks: ${graph.weeks}`}
                            >
                                <div class="month-labels" aria-hidden="true">
                                    {graph.months.map((month) => <span style={`grid-column: ${month.column} / span 3`}>{month.label}</span>)}
                                </div>
                                <div class="graph-row">
                                    <div class="day-labels" aria-hidden="true">
                                        <span></span><span>Mon</span><span></span><span>Wed</span><span></span><span>Fri</span><span></span>
                                    </div>
                                    <div class="contribution-grid" role="img" aria-label={`${graph.year} 年源码提交热力图，共 ${graph.count} 次提交，${graph.activeDays.length} 个活跃日。下方可查看每日记录。`}>
                                        {graph.levels.map((week) => (
                                            <div class="week">
                                                {week.map((cell) => (
                                                    <span aria-hidden="true" class:list={[`level-${cell.level}`, { outside: !cell.inYear }]} title={cell.inYear ? `${cell.date}：${cell.count} 次源码提交` : undefined}></span>
                                                ))}
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                    <div class="graph-footer">
                        <span class="legend" aria-label="颜色由浅到深，表示 0 次、1 次、2 次、3 到 4 次和 5 次以上提交">少 <i class="level-0" aria-hidden="true"></i><i class="level-1" aria-hidden="true"></i><i class="level-2" aria-hidden="true"></i><i class="level-3" aria-hidden="true"></i><i class="level-4" aria-hidden="true"></i> 多</span>
                    </div>
                    {yearGraphs.map((graph, index) => (
                        <details class="daily-records" data-record-year={graph.year} hidden={index !== 0}>
                            <summary>查看 {graph.year} 年的每日提交记录（{graph.activeDays.length} 个活跃日）</summary>
                            {graph.activeDays.length > 0 ? (
                                <ul>{graph.activeDays.map(([date, count]) => <li><time datetime={date}>{date}</time><span>{count} 次提交</span></li>)}</ul>
                            ) : <p>这一年没有可用的源码提交记录。</p>}
                        </details>
                    ))}
                </div>
                <p class="activity-note">来源：本仓库 <code>src/</code> 的 Git 提交。{!historyAvailable && '本次构建未能读取 Git 历史，图表暂为空。'}</p>
            </section>

            <section class="values" aria-labelledby="values-title">
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">03 / SMALL RULES</p>
                        <h2 id="values-title">写给未来的自己</h2>
                    </div>
                </div>
                <div class="value-grid">
                    <article><Icon name="search" size={28} class="value-icon" /><h3>保持好奇</h3><p>先问为什么，再决定怎么做。</p></article>
                    <article><Icon name="pen" size={28} class="value-icon" /><h3>诚实记录</h3><p>承认不知道，也记录走过的弯路。</p></article>
                    <article><Icon name="growth" size={28} class="value-icon" /><h3>慢慢变好</h3><p>让每一次小小的迭代都算数。</p></article>
                </div>
            </section>

            <div class="closing-note">
                <p>路虽远，行则将至。</p>
                <a class="text-link" href={`${base}blog/`}>从一篇文章开始 <span aria-hidden="true">↗</span></a>
            </div>
        </main>
        <Footer />
    </body>
</html>

<script>
    const tabs = document.querySelectorAll<HTMLButtonElement>('[data-year-tab]');
    const panels = document.querySelectorAll<HTMLElement>('.year-panel');
    const records = document.querySelectorAll<HTMLDetailsElement>('[data-record-year]');
    const total = document.querySelector<HTMLElement>('#contribution-total');

    tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
            const year = tab.dataset.yearTab;
            tabs.forEach((item) => {
                const active = item === tab;
                item.classList.toggle('active', active);
                item.setAttribute('aria-pressed', String(active));
            });
            panels.forEach((panel) => {
                panel.hidden = panel.dataset.year !== year;
            });
            records.forEach((record) => {
                record.hidden = record.dataset.recordYear !== year;
            });
            if (total && year) {
                total.textContent = `${year} 年 · ${Number(tab.dataset.count ?? 0)} 次源码提交`;
            }
        });
    });
</script>

<style>
    .about-page {
        padding-top: clamp(1.5rem, 4vw, 3rem);
    }

    /* --- Intro ------------------------------------------------------------ */

    .about-intro {
        padding-bottom: var(--space-2xl);
        border-bottom: 1px solid var(--line-ink);
    }
    .intro-copy {
        grid-column: 1 / span 7;
    }
    .intro-copy h1 {
        margin: var(--space-m) 0;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: var(--step-4);
        line-height: 1.3;
        letter-spacing: -0.035em;
    }
    .lead {
        margin-bottom: var(--space-xs);
        color: var(--ink);
        font-size: var(--step-1);
        line-height: 1.7;
    }

    /* The profile card is a spec block: hairline rules, mono keys. */
    .profile-note {
        grid-column: 9 / -1;
        align-self: end;
        padding-top: var(--space-s);
        border-top: 1px solid var(--line-ink);
    }
    .profile-monogram {
        display: block;
        padding-bottom: var(--space-2xs);
        color: var(--ink);
        font-family: var(--font-display);
        font-size: var(--step-3);
        letter-spacing: 0.1em;
        line-height: 1;
        margin-bottom: var(--space-m);
    }
    .profile-note dl {
        margin: 0;
        border-top: 1px solid var(--line);
    }
    .profile-note dl > div {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-s);
        padding-block: var(--space-2xs);
        border-bottom: 1px solid var(--line);
        font-size: var(--step--2);
    }
    .profile-note dt {
        display: grid;
        flex-shrink: 0;
        color: var(--muted);
    }
    .profile-note dd {
        margin: 0;
        text-align: right;
    }

    /* --- Story ------------------------------------------------------------ */

    .about-story {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--gutter);
        padding-block: var(--space-2xl);
        border-bottom: 1px solid var(--line-ink);
    }
    .section-label {
        grid-column: 1 / span 3;
        align-self: start;
        margin: 0;
        color: var(--muted);
    }
    .section-label .index {
        margin-right: var(--space-2xs);
    }
    .story-copy {
        grid-column: 5 / -1;
    }
    .story-copy h2 {
        margin: 0 0 var(--space-m);
        font-family: var(--font-display);
        font-size: var(--step-3);
        font-weight: 400;
        line-height: 1.35;
        letter-spacing: -0.03em;
    }
    .journey {
        margin: 0;
    }
    .journey figcaption {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        margin-top: var(--space-2xs);
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: var(--step--1);
        letter-spacing: 0.08em;
        text-align: center;
    }
    .journey figcaption span {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-3xs);
    }
    .story-links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-m);
        margin-top: var(--space-s);
    }

    /* --- Activity --------------------------------------------------------- */

    .activity-section,
    .values {
        padding-block: var(--space-2xl);
        border-bottom: 1px solid var(--line-ink);
    }
    .section-note {
        margin: 0;
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: var(--step--2);
        letter-spacing: 0.04em;
    }

    .contribution-card {
        min-width: 0;
        padding: var(--space-m);
        border: 1px solid var(--line);
        background: var(--surface);
        font-size: var(--step--2);
        transition: background-color var(--motion-base), border-color var(--motion-base);
    }
    .contribution-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: var(--space-s);
        margin-bottom: var(--space-m);
    }
    .contribution-header strong {
        color: var(--ink);
        font-family: var(--font-mono);
        font-size: var(--step--1);
        font-variant-numeric: tabular-nums;
    }
    .year-list {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3xs);
    }
    .year-list button {
        min-width: 58px;
        min-height: 44px;
        padding: 0.4rem 0.7rem;
        color: var(--muted);
        background: transparent;
        border: 1px solid var(--line);
        font-family: var(--font-mono);
        font-size: var(--step--2);
        font-variant-numeric: tabular-nums;
        transition: color var(--motion-fast), border-color var(--motion-fast),
            background-color var(--motion-fast);
    }
    .year-list button:hover {
        color: var(--ink);
        border-color: var(--line-strong);
    }
    .year-list button.active {
        color: var(--accent-on);
        background: var(--accent);
        border-color: var(--accent);
    }

    .graph-scroll {
        padding-bottom: var(--space-2xs);
        overflow-x: auto;
    }
    .year-panel {
        min-width: 660px;
    }
    .month-labels {
        display: grid;
        grid-template-columns: repeat(var(--weeks), minmax(0, 1fr));
        height: 1.6rem;
        margin-left: 2.2rem;
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: 0.7rem;
    }
    .graph-row {
        display: flex;
        gap: var(--space-2xs);
    }
    .day-labels {
        display: grid;
        grid-template-rows: repeat(7, 1fr);
        flex: 0 0 1.7rem;
        color: var(--muted);
        font-size: 0.7rem;
        line-height: 1;
        text-align: right;
    }
    .day-labels span {
        align-self: center;
    }
    .contribution-grid {
        display: grid;
        grid-template-columns: repeat(var(--weeks), minmax(0, 1fr));
        gap: 3px;
        width: 100%;
        min-width: 0;
    }
    .week {
        display: grid;
        grid-template-rows: repeat(7, minmax(0, 1fr));
        gap: 3px;
    }
    /* Geometry only. The fill comes from the level classes below — putting a
       background here would out-specify them and flatten the whole scale. */
    .contribution-grid span,
    .legend i {
        display: block;
        aspect-ratio: 1;
        min-width: 0;
    }
    .contribution-grid span.outside {
        visibility: hidden;
    }

    /* Five steps, 0 through 4. Each colour is a token, so the scale follows
       the theme. These must out-rank no other background rule. */
    .contribution-grid .level-0,
    .legend .level-0 {
        background: var(--heat-0);
    }
    .contribution-grid .level-1,
    .legend .level-1 {
        background: var(--heat-1);
    }
    .contribution-grid .level-2,
    .legend .level-2 {
        background: var(--heat-2);
    }
    .contribution-grid .level-3,
    .legend .level-3 {
        background: var(--heat-3);
    }
    .contribution-grid .level-4,
    .legend .level-4 {
        background: var(--heat-4);
    }

    .graph-footer {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: var(--space-s);
        margin-top: var(--space-2xs);
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: 0.7rem;
    }
    .legend {
        display: inline-flex;
        align-items: center;
        flex-shrink: 0;
        gap: 4px;
    }
    .legend i {
        width: 11px;
    }

    .daily-records {
        margin-top: var(--space-s);
        padding-top: var(--space-2xs);
        border-top: 1px solid var(--line);
        color: var(--muted);
    }
    .daily-records summary {
        padding-block: var(--space-2xs);
        font-family: var(--font-mono);
        font-size: var(--step--2);
    }
    .daily-records ul {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        gap: var(--space-2xs) var(--space-l);
        margin: var(--space-2xs) 0;
        padding: 0;
        list-style: none;
    }
    .daily-records li {
        display: flex;
        justify-content: space-between;
        gap: var(--space-s);
        padding-block: 0.2rem;
        border-bottom: 1px solid var(--line);
        font-variant-numeric: tabular-nums;
    }
    .activity-note {
        margin: var(--space-s) 0 0;
        color: var(--muted);
        font-size: var(--step--2);
        line-height: 1.75;
    }

    /* --- Values ----------------------------------------------------------- */

    .value-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--space-l);
    }
    /* Each rule is marked by an icon like a drawing note, not boxed like a card. */
    .value-grid article {
        padding-top: var(--space-s);
        border-top: 2px solid var(--ink);
    }
    .value-grid :global(.value-icon) {
        color: var(--accent-text);
    }
    .value-grid h3 {
        margin: var(--space-2xs) 0 var(--space-3xs);
        font-family: var(--font-display);
        font-size: var(--step-1);
        font-weight: 400;
    }
    .value-grid p {
        margin: 0;
        color: var(--muted);
        font-size: var(--step--1);
    }

    /* --- Closing ---------------------------------------------------------- */

    .closing-note {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: var(--space-s);
        padding-top: var(--space-l);
    }
    .closing-note p {
        margin: 0;
        font-family: var(--font-display);
        font-size: var(--step-2);
    }

    /* --- Breakpoints ------------------------------------------------------ */

    @media (max-width: 1080px) {
        .intro-copy,
        .profile-note {
            grid-column: 1 / -1;
        }
        .profile-note {
            margin-top: var(--space-l);
        }
        .section-label {
            grid-column: 1 / span 2;
        }
        .story-copy {
            grid-column: 4 / -1;
        }
    }

    @media (max-width: 720px) {
        .about-intro {
            padding-bottom: var(--space-xl);
        }
        .about-story {
            grid-template-columns: 1fr;
            gap: var(--space-s);
            padding-block: var(--space-xl);
        }
        .section-label,
        .story-copy {
            grid-column: 1 / -1;
        }
        .activity-section,
        .values {
            padding-block: var(--space-xl);
        }
        .contribution-card {
            padding: var(--space-s);
        }
        .value-grid {
            grid-template-columns: 1fr;
            gap: var(--space-m);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .year-list button,
        .contribution-card {
            transition: none;
        }
    }
</style>
