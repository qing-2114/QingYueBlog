---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ProjectLab from '../../components/ProjectLab.astro';
import ReActLab from '../../components/ReActLab.astro';
import ExperimentFlow from '../../components/ExperimentFlow.astro';
import {
    agentScopeFlow,
    autoGenFlow,
    camelFlow,
    langGraphFlow,
    myLlmFlow,
    myReActAgentFlow,
    myReflectionAgentFlow,
    mySimpleAgentFlow,
    planFlow,
    reflectionFlow,
} from '../../data/experiment-flows';

export async function getStaticPaths() {
    const projects = await getCollection('projects');
    return projects.map((project) => ({ params: { slug: project.id }, props: project }));
}

type Props = CollectionEntry<'projects'>;
const project = Astro.props;
const { Content, headings } = await render(project);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const isAgent = project.id === 'my-hello-agent';
const coreFlows = [planFlow, reflectionFlow, agentScopeFlow, autoGenFlow, camelFlow, langGraphFlow];
const extensionFlows = [myLlmFlow, mySimpleAgentFlow, myReActAgentFlow, myReflectionAgentFlow];
const projectNavigation = isAgent
    ? [
        { label: '旅行 Agent', id: 'lab-title' },
        { label: 'ReAct', id: 'react-lab-title' },
        { label: 'Plan-and-Solve', id: planFlow.id },
        { label: 'Reflection', id: reflectionFlow.id },
        { label: 'AgentScope', id: agentScopeFlow.id },
        { label: 'AutoGen', id: autoGenFlow.id },
        { label: 'CAMEL', id: camelFlow.id },
        { label: 'LangGraph', id: langGraphFlow.id },
        { label: '第七章扩展', id: 'chapter-seven-title' },
    ]
    : headings.filter((heading) => heading.depth === 2).map((heading) => ({ label: heading.text, id: heading.slug }));
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <BaseHead title={`${project.data.title} · 项目档案`} description={project.data.description} />
    </head>
    <body>
        <Header />
        <main id="main-content" class:list={['project-page', { 'agent-project': isAgent }]}>
            <nav class="breadcrumb" aria-label="当前位置">
                <a href={`${base}projects/`}>实验与项目</a>
                <span aria-hidden="true">/</span>
                <span aria-current="page">{project.data.title}</span>
            </nav>
            <header class="project-header">
                <div class="project-title">
                    <p class="eyebrow">{isAgent ? 'AGENT EXPERIMENTS / 智能体实验' : 'PRODUCT STUDY / 产品实践'}</p>
                    <h1>{project.data.title}</h1>
                    <p class="summary">{project.data.description}</p>
                    <ul class="tag-row" aria-label="项目技术标签">
                        {project.data.tags.map((tag) => <li>{tag}</li>)}
                    </ul>
                </div>
                <aside class="project-facts" aria-label="项目基本信息">
                    <dl>
                        <div><dt>状态</dt><dd class:list={['status', project.data.status]}><i aria-hidden="true"></i>{project.data.statusLabel}</dd></div>
                        <div><dt>开始</dt><dd><time datetime={project.data.startDate.toISOString()}>{project.data.startDate.toLocaleDateString('zh-CN')}</time></dd></div>
                        {project.data.updatedDate && <div><dt>更新</dt><dd><time datetime={project.data.updatedDate.toISOString()}>{project.data.updatedDate.toLocaleDateString('zh-CN')}</time></dd></div>}
                    </dl>
                    {project.data.repo && <a class="source-link" href={project.data.repo} target="_blank" rel="noreferrer">查看 GitHub 源码 <span aria-hidden="true">↗</span></a>}
                    {project.data.source && <a class="source-link" href={project.data.source} target="_blank" rel="noreferrer">学习来源 · Hello Agents <span aria-hidden="true">↗</span></a>}
                </aside>
            </header>

            {projectNavigation.length > 0 && (
                <nav class="project-navigation" aria-label={isAgent ? '快速前往实验' : '项目内容目录'}>
                    <span>{isAgent ? '实验索引' : '内容索引'}</span>
                    <ul>
                        {projectNavigation.map((item) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}
                    </ul>
                </nav>
            )}

            <div class="project-body">
                {isAgent && <ProjectLab />}
                <article class="project-prose"><Content /></article>
                {isAgent && <ReActLab />}
                {isAgent && coreFlows.map((flow) => <ExperimentFlow flow={flow} />)}
                {project.data.source && (
                    <p class="source-note">学习来源：<a href={project.data.source} rel="noreferrer">{project.data.source}</a></p>
                )}
                {isAgent && (
                    <section class="chapter-seven-heading" aria-labelledby="chapter-seven-title">
                        <p class="eyebrow">7-EXPERIMENT / EXTENSIONS</p>
                        <h2 id="chapter-seven-title">第七章 · 四种独立扩展方法</h2>
                        <p>四个实验分别扩展模型 Provider、SimpleAgent 工具能力、ReAct 自纠能力和通用 Reflection 评估循环。它们共享项目配置，彼此独立。</p>
                        <nav class="extension-navigation" aria-label="第七章扩展实验">
                            <ul>{extensionFlows.map((flow) => <li><a href={`#${flow.id}`}>{flow.title.split(' · ')[0]}</a></li>)}</ul>
                        </nav>
                    </section>
                )}
                {isAgent && extensionFlows.map((flow) => <ExperimentFlow flow={flow} />)}
            </div>
            <footer class="project-footer">
                <a class="text-link" href={`${base}projects/`}>← 返回实验与项目</a>
                <a class="text-link" href="#main-content">回到顶部 ↑</a>
            </footer>
        </main>
        <Footer />
    </body>
</html>

<style>
    .project-page {
        padding-top: clamp(1.5rem, 4vw, 3rem);
    }
    .breadcrumb {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--space-2xs);
        margin-bottom: var(--space-l);
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: var(--step--2);
        letter-spacing: 0.06em;
    }
    .breadcrumb a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        color: var(--muted);
        text-decoration: none;
    }
    .breadcrumb a:hover {
        color: var(--accent-text);
    }

    /* Header: title runs wide, facts settle into a spec column. */
    .project-header {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 15rem;
        gap: clamp(2rem, 5vw, 5rem);
        align-items: end;
        padding-bottom: var(--space-l);
        border-bottom: 1px solid var(--line-ink);
    }
    .project-title {
        min-width: 0;
    }
    .project-title .eyebrow {
        margin-bottom: var(--space-s);
    }
    .project-header h1 {
        margin: 0 0 var(--space-s);
        font-family: var(--font-display);
        font-size: var(--step-4);
        font-weight: 400;
        line-height: 1.28;
        letter-spacing: -0.032em;
        overflow-wrap: anywhere;
    }
    .summary {
        max-width: 46rem;
        color: var(--muted);
        font-size: var(--step-0);
        line-height: 1.85;
    }
    .tag-row {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3xs);
        margin: var(--space-m) 0 0;
        padding: 0;
        list-style: none;
    }
    .tag-row li {
        padding: 0.15rem 0.5rem;
        color: var(--muted);
        border: 1px solid var(--line);
        font-family: var(--font-mono);
        font-size: var(--step--2);
    }

    .project-facts {
        border-top: 1px solid var(--line-ink);
    }
    .project-facts dl {
        margin: 0;
    }
    .project-facts dl > div {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--space-s);
        padding-block: var(--space-2xs);
        border-bottom: 1px solid var(--line);
        font-size: var(--step--2);
    }
    .project-facts dt {
        color: var(--muted);
        font-family: var(--font-mono);
        letter-spacing: 0.06em;
    }
    .project-facts dd {
        margin: 0;
        font-variant-numeric: tabular-nums;
    }
    .status {
        display: inline-flex;
        align-items: center;
        gap: var(--space-3xs);
    }
    .status i {
        width: 7px;
        height: 7px;
        background: var(--accent);
    }
    .status.completed i {
        background: var(--success);
    }
    .status.paused i {
        background: var(--signal);
    }
    .source-link {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-2xs);
        width: 100%;
        min-height: 44px;
        border-bottom: 1px solid var(--line);
        color: var(--accent-text);
        font-family: var(--font-mono);
        font-size: var(--step--2);
        text-decoration: none;
    }
    .source-link:hover {
        color: var(--ink);
    }

    /* Section index — a scrolling tab strip on one hairline. */
    .project-navigation {
        display: flex;
        align-items: baseline;
        gap: var(--space-s);
        padding-block: var(--space-2xs);
        border-bottom: 1px solid var(--line-ink);
    }
    .project-navigation > span {
        flex-shrink: 0;
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: var(--step--2);
        letter-spacing: 0.08em;
    }
    .project-navigation ul,
    .extension-navigation ul {
        display: flex;
        flex-wrap: wrap;
        gap: 0 var(--space-s);
        margin: 0;
        padding: 0;
        list-style: none;
    }
    .project-navigation a,
    .extension-navigation a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        border-bottom: 2px solid transparent;
        color: var(--ink);
        font-size: var(--step--2);
        text-decoration: none;
        transition: color var(--motion-fast), border-color var(--motion-fast);
    }
    .project-navigation a:hover,
    .extension-navigation a:hover {
        color: var(--accent-text);
        border-bottom-color: var(--accent);
    }

    .project-body {
        width: min(1000px, 100%);
        margin-inline: auto;
        min-width: 0;
    }
    .project-prose {
        width: min(760px, 100%);
        margin: var(--space-xl) auto;
        font-size: var(--step-0);
        line-height: 1.9;
    }
    .agent-project .project-prose {
        margin: 0;
    }
    .project-prose :global(h2) {
        margin-top: var(--space-2xl);
        padding-top: var(--space-s);
        border-top: 1px solid var(--line);
        font-family: var(--font-display);
        font-size: var(--step-2);
        font-weight: 400;
        letter-spacing: -0.02em;
        scroll-margin-top: 6rem;
    }
    .project-prose :global(h3) {
        margin-top: var(--space-xl);
        font-size: var(--step-1);
        scroll-margin-top: 6rem;
    }
    .project-prose :global(p) {
        color: var(--muted);
    }
    .project-prose :global(img) {
        width: 100%;
        height: auto;
        margin: var(--space-m) 0;
        border: 1px solid var(--line);
    }
    /* Anchored sections clear the sticky header the same way everywhere. */
    .project-body :global(.experiment-flow),
    .project-body :global(.project-lab),
    .project-body :global(.react-lab),
    .project-body :global(h2[id]) {
        scroll-margin-top: 6rem;
    }
    .source-note {
        margin: var(--space-l) 0;
        color: var(--muted);
        font-size: var(--step--2);
        overflow-wrap: anywhere;
    }

    .chapter-seven-heading {
        margin: var(--space-2xl) 0 var(--space-m);
        padding-top: var(--space-l);
        border-top: 2px solid var(--ink);
    }
    .chapter-seven-heading h2 {
        margin-bottom: var(--space-s);
        font-family: var(--font-display);
        font-size: var(--step-2);
        font-weight: 400;
    }
    .chapter-seven-heading > p:last-of-type {
        max-width: 46rem;
        margin-bottom: var(--space-2xs);
        color: var(--muted);
        font-size: var(--step--1);
    }
    .extension-navigation a {
        color: var(--accent-text);
    }

    .project-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: var(--space-s);
        margin-top: var(--space-2xl);
        padding-top: var(--space-s);
        border-top: 1px solid var(--line-ink);
    }

    @media (max-width: 900px) {
        .project-header {
            grid-template-columns: minmax(0, 1fr);
            gap: var(--space-m);
        }
        .project-facts {
            max-width: 26rem;
        }
        .project-navigation {
            align-items: start;
            flex-direction: column;
            gap: var(--space-3xs);
        }
    }

    @media (max-width: 720px) {
        .breadcrumb {
            margin-bottom: var(--space-s);
        }
        .project-header h1 {
            font-size: var(--step-3);
        }
        .project-prose {
            margin-top: var(--space-l);
        }
        .project-footer {
            margin-top: var(--space-xl);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .project-navigation a,
        .extension-navigation a {
            transition: none;
        }
    }
</style>
