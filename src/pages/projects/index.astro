---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const projects = (await getCollection('projects')).sort((a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf());
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title={`项目 · ${SITE_TITLE}`} description="清月正在进行与已完成的项目记录。" /></head>
	<body>
		<Header />
		<main>
			<section class="projects-intro">
				<div><p class="eyebrow">PROJECTS</p><h1>项目</h1></div>
				<p>把正在构建的东西放到一个可以持续更新的地方。这里记录目标、代码边界、阶段变化和可验证的实验结果。</p>
			</section>
			<div class="status-line"><span><strong>{projects.length}</strong> 个项目记录</span><span>按最近开始时间排列</span></div>
			<section class="project-grid" aria-label="项目列表">
				{projects.map((project) => (
					<a class="project-card" href={`${base}projects/${project.id}/`}>
						<div class="card-top"><span class:list={['status', project.data.status]}><i aria-hidden="true"></i>{project.data.statusLabel}</span><span class="project-date">始于 {project.data.startDate.toLocaleDateString('zh-CN')}</span></div>
						<h2>{project.data.title}</h2><p>{project.data.description}</p>
						<div class="card-bottom"><div class="tags">{project.data.tags.slice(0, 3).map((tag) => <span>#{tag}</span>)}</div><span class="arrow">查看档案 →</span></div>
					</a>
				))}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main { padding-top: 4rem; }
	.projects-intro { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2rem; }
	.eyebrow { margin: 0 0 .55rem; color: var(--accent); font-size: .72rem; font-weight: 700; letter-spacing: .16em; }
	.projects-intro h1 { margin: 0; font-size: clamp(2.4rem, 6vw, 4rem); }
	.projects-intro > p { max-width: 31rem; margin: 0 0 .35rem; color: var(--muted); font-size: .96rem; }
	.status-line { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: .85rem; color: var(--muted); font-size: .8rem; }
	.status-line strong { color: var(--ink); }
	.project-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; }
	.project-card { display: flex; min-height: 250px; flex-direction: column; padding: 1.35rem; color: inherit; background: rgba(255,255,255,.68); border: 1px solid var(--line); border-radius: 12px; box-shadow: 0 8px 24px rgba(38,111,170,.06); text-decoration: none; transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease; }
	.project-card:hover { border-color: rgba(40,127,195,.35); box-shadow: var(--box-shadow); transform: translateY(-4px); }
	.card-top, .card-bottom { display: flex; align-items: center; justify-content: space-between; gap: .7rem; }
	.status { display: inline-flex; align-items: center; gap: .38rem; color: var(--accent-dark); font-size: .75rem; font-weight: 700; }
	.status i { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }
	.status.completed i { background: #3c9b76; }
	.status.paused i { background: #d58c4c; }
	.project-date { color: var(--muted); font-size: .72rem; }
	.project-card h2 { margin: 2.4rem 0 .65rem; font-size: 1.45rem; }
	.project-card p { margin: 0; color: var(--muted); font-size: .9rem; line-height: 1.65; }
	.card-bottom { margin-top: auto; padding-top: 1.4rem; }
	.tags { display: flex; flex-wrap: wrap; gap: .35rem; color: var(--muted); font-size: .72rem; }
	.tags span { padding: .15rem .4rem; background: rgba(91,163,224,.1); border-radius: 999px; }
	.arrow { color: var(--accent); font-size: .78rem; white-space: nowrap; }
	@media (max-width: 620px) { main { padding-top: 3rem; } .projects-intro { display: block; } .projects-intro > p { margin-top: 1rem; } .status-line { align-items: start; flex-direction: column; gap: .2rem; } }
</style>
