---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ExperimentFlow from '../../components/ExperimentFlow.astro';
import { langGraphFlow } from '../../data/experiment-flows';
import workbench from '../../assets/grok-build-web/workbench.png';
import { SITE_TITLE } from '../../consts';

const projects = (await getCollection('projects')).sort(
    (a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf(),
);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const formatDate = (date: Date) => date.toLocaleDateString('zh-CN');
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <BaseHead title={`实验与项目 · ${SITE_TITLE}`} description="清月的 Agent 实验、开发项目与持续更新的实践记录。" />
    </head>
    <body>
        <Header />
        <main id="main-content" class="projects-page">
            <header class="page-intro" data-reveal>
                <p class="eyebrow">LABS / 工程实验室</p>
                <h1>把想法，<br />做成可以运行的东西。</h1>
                <div class="intro-bottom">
                    <p>从智能体的执行链路，到本地工作台的产品界面。这里保留每个项目的目标、过程与阶段记录。</p>
                    <span class="project-count">{String(projects.length).padStart(2, '0')} <span>个项目档案</span></span>
                </div>
            </header>

            <section class="project-list" aria-label="项目档案">
                {projects.map((project, index) => (
                    <article class="project-entry">
                        <div class="project-information">
                            <div class="entry-kicker">
                                <span class="entry-number">{String(index + 1).padStart(2, '0')}</span>
                                <span>{project.id === 'my-hello-agent' ? 'AGENT EXPERIMENTS / 智能体实验' : 'PRODUCT STUDY / 产品实践'}</span>
                            </div>
                            <h2><a href={`${base}projects/${project.id}/`}>{project.data.title}</a></h2>
                            <p class="description">{project.data.description}</p>
                            <div class="entry-meta">
                                <span class:list={['status', project.data.status]}><i aria-hidden="true"></i>{project.data.statusLabel}</span>
                                <span>更新于 {formatDate(project.data.updatedDate ?? project.data.startDate)}</span>
                            </div>
                            <ul class="tags" aria-label="项目技术标签">
                                {project.data.tags.slice(0, 5).map((tag) => <li>{tag}</li>)}
                            </ul>
                            <a class="project-link" href={`${base}projects/${project.id}/`}>
                                {project.id === 'my-hello-agent' ? '探索实验链路' : '查看项目档案'} <span aria-hidden="true">↗</span>
                            </a>
                        </div>
                        {project.id === 'grok-build-web' ? (
                            <a class="project-preview" href={`${base}projects/${project.id}/`} aria-label="查看 Grok Build Web 项目">
                                <Image src={workbench} alt="Grok Build Web 的项目栏、流式对话与底部输入坞" width={960} loading="lazy" />
                                <span class="preview-caption">界面实录 · 本地 Web 工作台 <span aria-hidden="true">↗</span></span>
                            </a>
                        ) : project.id === 'my-hello-agent' ? (
                            <div class="experiment-preview">
                                <ExperimentFlow flow={langGraphFlow} />
                            </div>
                        ) : null}
                    </article>
                ))}
            </section>
            <p class="lab-footnote">项目会随实践更新。流程演示、实现状态与验证记录，以各项目档案中的说明为准。</p>
        </main>
        <Footer />
    </body>
</html>

<style>
    .projects-page {
        padding-top: clamp(3rem, 7vw, 6rem);
    }
    .page-intro {
        padding-bottom: 3.5rem;
    }
    .eyebrow, .entry-kicker {
        color: var(--accent);
        font-family: var(--font-mono, monospace);
        font-size: .75rem;
        letter-spacing: .09em;
    }
    .eyebrow {
        margin-bottom: 1.4rem;
    }
    .page-intro h1 {
        font-family: var(--font-display);
        font-weight: 400;
        margin: 0 0 2rem;
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        line-height: 1.5;
        letter-spacing: -.04em;
    }
    .intro-bottom {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 2rem;
    }
    .intro-bottom p {
        max-width: 36rem;
        margin: 0;
        color: var(--muted);
    }
    .project-count {
        flex-shrink: 0;
        color: var(--ink);
        font-family: var(--font-mono, monospace);
        font-size: 2.3rem;
        line-height: 1;
    }
    .project-count span {
        margin-left: .5rem;
        color: var(--muted);
        font-size: .8rem;
    }
    .project-entry {
        display: grid;
        grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
        align-items: center;
        gap: clamp(2rem, 4vw, 4rem);
        padding: 3rem 0;
        border-top: 1px solid var(--line);
    }
    .entry-kicker {
        display: flex;
        gap: .9rem;
        align-items: center;
        margin-bottom: 1.5rem;
        font-size: .7rem;
    }
    .entry-number {
        color: var(--muted);
    }
    .project-entry h2 {
        margin: 0 0 1rem;
        font-size: clamp(1.7rem, 3vw, 2.5rem);
        letter-spacing: -.03em;
    }
    .project-entry h2 a {
        color: var(--ink);
        text-decoration: none;
    }
    .project-entry h2 a:hover {
        color: var(--accent);
    }
    .description {
        color: var(--muted);
        font-size: .95rem;
        line-height: 1.85;
    }
    .entry-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin: 1.5rem 0 1rem;
        color: var(--muted);
        font-size: .78rem;
    }
    .status {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        color: var(--ink);
    }
    .status i {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--accent);
    }
    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
        margin: 0 0 1.4rem;
        padding: 0;
        list-style: none;
    }
    .tags li {
        padding: .2rem .5rem;
        border: 1px solid var(--line);
        border-radius: 3px;
        color: var(--muted);
        font-size: .72rem;
    }
    .project-link {
        display: inline-flex;
        align-items: center;
        gap: 1.5rem;
        min-height: 44px;
        color: var(--accent);
        font-size: .88rem;
        font-weight: 700;
        text-decoration: none;
    }
    .project-preview {
        display: block;
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: var(--radius, 6px);
        background: var(--surface, white);
        color: var(--muted);
        text-decoration: none;
    }
    .project-preview :global(img) {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 0;
    }
    .preview-caption {
        display: flex;
        justify-content: space-between;
        padding: 1rem 1.2rem;
        border-top: 1px solid var(--line);
        font-size: .78rem;
    }
    .experiment-preview {
        min-width: 0;
    }
    .experiment-preview :global(.experiment-flow) {
        margin: 0;
    }
    .lab-footnote {
        margin: 1rem 0 0;
        padding-top: 1.5rem;
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: .8rem;
    }
    @media (max-width: 840px) {
        .project-entry {
            grid-template-columns: minmax(0, 1fr);
        }
    }
    @media (max-width: 560px) {
        .intro-bottom {
            align-items: start;
            flex-direction: column;
        }
        .page-intro {
            padding-bottom: 2rem;
        }
        .project-entry {
            padding: 2rem 0;
        }
    }
</style>
