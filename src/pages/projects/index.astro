---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ExperimentFlow from '../../components/ExperimentFlow.astro';
import { langGraphFlow } from '../../data/experiment-flows';
import workbench from '../../assets/grok-build-web/workbench.png';
import { SITE_TITLE } from '../../consts';

const projects = (await getCollection('projects')).sort(
    (a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf(),
);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const pad = (value: number) => String(value).padStart(2, '0');
const formatDate = (date: Date) => date.toLocaleDateString('zh-CN');
const kicker = (id: string) =>
    id === 'my-hello-agent' ? 'AGENT EXPERIMENTS / 智能体实验' : 'PRODUCT STUDY / 产品实践';
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <BaseHead title={`实验与项目 · ${SITE_TITLE}`} description="清月的 Agent 实验、开发项目与持续更新的实践记录。" />
    </head>
    <body>
        <Header />
        <main id="main-content" class="projects-page">

            <header class="page-intro">
                <p class="eyebrow">LABS&nbsp;/&nbsp;工程实验室</p>
                <div class="grid intro-grid">
                    <h1>把想法，<br />做成可以运行的东西。</h1>
                    <div class="intro-caption">
                        <p>从智能体的执行链路，到本地工作台的产品界面。这里保留每个项目的目标、过程与阶段记录。</p>
                        <span class="project-total">{pad(projects.length)} 个项目档案</span>
                    </div>
                </div>
            </header>

            <section class="project-list" aria-label="项目档案">
                {projects.map((project, index) => (
                    <article class="project-entry">
                        <div class="entry-head">
                            <span class="entry-number">{pad(index + 1)}</span>
                            <span class="entry-kicker">{kicker(project.id)}</span>
                            <span class="entry-updated">更新于 {formatDate(project.data.updatedDate ?? project.data.startDate)}</span>
                        </div>

                        <div class="entry-body">
                            <div class="entry-information">
                                <h2><a href={`${base}projects/${project.id}/`}>{project.data.title}</a></h2>
                                <p class="description">{project.data.description}</p>
                                <div class="entry-meta">
                                    <span class:list={['status', project.data.status]}><i aria-hidden="true"></i>{project.data.statusLabel}</span>
                                </div>
                                <ul class="tags" aria-label="项目技术标签">
                                    {project.data.tags.slice(0, 5).map((tag) => <li>{tag}</li>)}
                                </ul>
                                <a class="text-link" href={`${base}projects/${project.id}/`}>
                                    {project.id === 'my-hello-agent' ? '探索实验链路' : '查看项目档案'} <span aria-hidden="true">→</span>
                                </a>
                            </div>

                            <div class="entry-preview">
                                {project.id === 'grok-build-web' ? (
                                    <a class="project-preview" href={`${base}projects/${project.id}/`} aria-label="查看 Grok Build Web 项目">
                                        <Image src={workbench} alt="Grok Build Web 的项目栏、流式对话与底部输入坞" width={960} loading="lazy" />
                                        <span class="preview-caption">界面实录 · 本地 Web 工作台 <span aria-hidden="true">↗</span></span>
                                    </a>
                                ) : project.id === 'my-hello-agent' ? (
                                    <div class="experiment-preview">
                                        <ExperimentFlow flow={langGraphFlow} />
                                    </div>
                                ) : null}
                            </div>
                        </div>
                    </article>
                ))}
            </section>

            <p class="lab-footnote">项目会随实践更新。流程演示、实现状态与验证记录，以各项目档案中的说明为准。</p>
        </main>
        <Footer />
    </body>
</html>

<style>
    .projects-page {
        padding-top: clamp(1.5rem, 4vw, 3rem);
    }

    /* --- Intro ------------------------------------------------------------ */

    .page-intro {
        padding-bottom: var(--space-2xl);
        border-bottom: 1px solid var(--line-ink);
    }
    .page-intro h1 {
        grid-column: 1 / span 7;
        margin: 0;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: var(--step-4);
        line-height: 1.3;
        letter-spacing: -0.035em;
    }
    .intro-caption {
        grid-column: 9 / -1;
        align-self: end;
    }
    .intro-caption p {
        color: var(--muted);
        font-size: var(--step--1);
        line-height: 1.85;
    }
    .project-total {
        display: block;
        margin-top: var(--space-s);
        padding-top: var(--space-2xs);
        border-top: 1px solid var(--line);
        color: var(--accent-text);
        font-family: var(--font-mono);
        font-size: var(--step--2);
        letter-spacing: 0.12em;
    }

    /* --- Entries ---------------------------------------------------------- */

    /* The head is a full-width tab strip: number, kind, date — the same
       "spec line" used on the article page. */
    .project-entry {
        padding-block: var(--space-xl);
        border-bottom: 1px solid var(--line-ink);
    }
    .entry-head {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: var(--space-2xs) var(--space-m);
        margin-bottom: var(--space-l);
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: var(--step--2);
        letter-spacing: 0.1em;
    }
    .entry-number {
        color: var(--accent-text);
        font-size: var(--step-1);
        font-variant-numeric: tabular-nums;
        letter-spacing: 0;
        line-height: 1;
    }
    .entry-kicker {
        color: var(--ink);
    }
    .entry-updated {
        margin-left: auto;
    }

    .entry-body {
        display: grid;
        grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
        align-items: start;
        gap: clamp(2rem, 4vw, 4rem);
    }
    .entry-information {
        min-width: 0;
    }
    .project-entry h2 {
        margin: 0 0 var(--space-s);
        font-family: var(--font-display);
        font-size: var(--step-3);
        font-weight: 400;
        letter-spacing: -0.03em;
    }
    .project-entry h2 a {
        color: var(--ink);
        text-decoration: none;
        transition: color var(--motion-fast);
    }
    .project-entry h2 a:hover {
        color: var(--accent-text);
    }
    .description {
        color: var(--muted);
        font-size: var(--step--1);
        line-height: 1.85;
    }
    .entry-meta {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-s);
        margin: var(--space-m) 0 var(--space-s);
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: var(--step--2);
    }
    .status {
        display: inline-flex;
        align-items: center;
        gap: var(--space-3xs);
        color: var(--ink);
    }
    .status i {
        width: 7px;
        height: 7px;
        background: var(--accent);
    }
    .status.completed i {
        background: var(--success);
    }
    .status.paused i {
        background: var(--signal);
    }
    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3xs);
        margin: 0 0 var(--space-m);
        padding: 0;
        list-style: none;
    }
    .tags li {
        padding: 0.15rem 0.5rem;
        color: var(--muted);
        border: 1px solid var(--line);
        font-family: var(--font-mono);
        font-size: var(--step--2);
    }

    /* --- Preview ---------------------------------------------------------- */

    .entry-preview {
        min-width: 0;
    }
    .project-preview {
        display: block;
        overflow: hidden;
        color: var(--muted);
        background: var(--plate);
        border: 1px solid var(--line);
        text-decoration: none;
        transition: border-color var(--motion-fast);
    }
    .project-preview :global(img) {
        display: block;
        width: 100%;
        height: auto;
        transition: transform var(--motion-slow);
    }
    .preview-caption {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-s);
        padding: var(--space-2xs) var(--space-s);
        background: var(--surface);
        border-top: 1px solid var(--line);
        font-family: var(--font-mono);
        font-size: var(--step--2);
    }
    .project-preview:is(:hover, :focus-visible) {
        border-color: var(--accent);
    }
    .project-preview:is(:hover, :focus-visible) :global(img) {
        transform: scale(1.02);
    }
    .experiment-preview {
        min-width: 0;
    }
    .experiment-preview :global(.experiment-flow) {
        margin: 0;
    }

    .lab-footnote {
        margin: var(--space-l) 0 0;
        padding-top: var(--space-s);
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: var(--step--2);
        line-height: 1.75;
    }

    /* --- Breakpoints ------------------------------------------------------ */

    @media (max-width: 1080px) {
        .page-intro h1,
        .intro-caption {
            grid-column: 1 / -1;
        }
        .intro-caption {
            margin-top: var(--space-m);
        }
        .project-total {
            display: inline-block;
            margin-top: 0;
            margin-left: var(--space-s);
            padding-top: 0;
            border-top: 0;
        }
    }

    @media (max-width: 900px) {
        .entry-body {
            grid-template-columns: minmax(0, 1fr);
            gap: var(--space-l);
        }
    }

    @media (max-width: 720px) {
        .page-intro {
            padding-bottom: var(--space-xl);
        }
        .project-entry {
            padding-block: var(--space-l);
        }
        .entry-updated {
            margin-left: 0;
            flex-basis: 100%;
        }
        .project-total {
            display: block;
            margin-left: 0;
            margin-top: var(--space-2xs);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .project-entry h2 a,
        .project-preview :global(img) {
            transition: none;
        }
        .project-preview:is(:hover, :focus-visible) :global(img) {
            transform: none;
        }
    }
</style>
